<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:b="urn:biomerte:v1" targetNamespace="urn:biomerte:workflows">
  <process id="capability-followup" name="Run a capability and resume its caller" isExecutable="true"
      b:inputs='{"contract":"str","arguments":"obj","caller":"str","success_prompt":"str","failure_prompt":"str","resource":"str?","caller_resource":"str?","context":"obj?","success_equals":"obj?"}'
      b:outputs='{"outcome":"obj","continuation":"obj"}'>
    <startEvent id="start"/>
    <sequenceFlow id="s1" sourceRef="start" targetRef="prepare"/>
    <serviceTask id="prepare" name="Validate caller and bind inputs" b:operation="continuation.prepare"
        b:args='{"$":"input"}' b:save="bindings"/>
    <sequenceFlow id="s2" sourceRef="prepare" targetRef="work"/>
    <serviceTask id="work" name="Run delegated capability" b:contractRef="input.contract"
        b:resourceRef="bindings.resource" b:args='{"$":"input.arguments"}' b:leaseScope="activity"
        b:captureOutcome="true" b:successEqualsRef="bindings.success_equals" b:save="outcome"/>
    <sequenceFlow id="s3" sourceRef="work" targetRef="route"/>
    <exclusiveGateway id="route" name="Did the capability succeed?" default="failure"/>
    <sequenceFlow id="success" sourceRef="route" targetRef="successPrompt">
      <conditionExpression>{"$":"outcome.ok"}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="failure" sourceRef="route" targetRef="failurePrompt"/>
    <task id="successPrompt" name="Use caller's success prompt" b:set='{"prompt":{"$":"input.success_prompt"}}'/>
    <task id="failurePrompt" name="Use caller's failure prompt" b:set='{"prompt":{"$":"input.failure_prompt"}}'/>
    <sequenceFlow id="s4" sourceRef="successPrompt" targetRef="resume"/>
    <sequenceFlow id="s5" sourceRef="failurePrompt" targetRef="resume"/>
    <serviceTask id="resume" name="Return prompt and tool output to the calling agent"
        b:contractRef="input.caller" b:resourceRef="bindings.caller_resource" b:leaseScope="activity"
        b:args='{"request":{"$":"prompt"},"context":{"caller_context":{"$":"bindings.context"},"outcome":{"$":"outcome"}}}'
        b:save="reply"/>
    <sequenceFlow id="s6" sourceRef="resume" targetRef="done"/>
    <endEvent id="done" b:result='{"outcome":{"$":"outcome"},"continuation":{"$":"reply"}}'/>
  </process>
</definitions>
