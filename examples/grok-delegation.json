{
  "name": "grok-review-observation",
  "inputs": {
    "observation": "str"
  },
  "outputs": {
    "summary": "str"
  },
  "steps": [
    {
      "type": "delegate",
      "to": "grok",
      "request": "Summarize the supplied observation in one sentence.",
      "context": {
        "observation": {
          "$": "input.observation"
        }
      },
      "outputs": {
        "summary": "str"
      },
      "save": "review"
    }
  ],
  "result": {
    "summary": {
      "$": "review.summary"
    }
  }
}
