ARG DEBIAN_IMAGE=debian@sha256:50b15ac0f2b79ba71bad6a3c7606e992c4cc3213aa9b47700efebe7e8678931f
FROM ${DEBIAN_IMAGE} AS backend
RUN test "$(dpkg --print-architecture)" = armhf \
    && apt-get update && apt-get install -y --no-install-recommends g++ make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY deploy/workers/radio/fm-backend/ /src/
RUN make && cp fm_transmitter /fm_transmitter

FROM ${DEBIAN_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 openssl ca-certificates sox sudo tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 pi && useradd -u 1000 -g 1000 -m pi \
    && mkdir -p /run/biomerte /run/lock /usr/local/lib/biomerte \
    && chown 1000:1000 /run/biomerte
WORKDIR /app
COPY biomerte /app/biomerte
COPY providers/pi-fm /app/providers/pi-fm
COPY deploy/workers/radio/entrypoint.py deploy/workers/radio/launch.py /app/deploy/workers/radio/
COPY deploy/workers/radio/tests /app/deploy/workers/radio/tests
COPY --from=backend /fm_transmitter /usr/local/lib/biomerte/fm_transmitter
COPY deploy/workers/radio/fm-backend/LICENSE /usr/share/doc/biomerte-fm-backend/LICENSE
RUN python3 -c 'import hashlib,json,pathlib; p=pathlib.Path("/usr/local/lib/biomerte/fm_transmitter"); pathlib.Path("/usr/local/lib/biomerte/fm-backend.json").write_text(json.dumps({"path":str(p),"sha256":hashlib.sha256(p.read_bytes()).hexdigest()})+"\n")' \
    && printf '%s\n' 'Defaults env_keep += "BIOMERTE_FM_BACKEND_MANIFEST"' 'pi ALL=(root) NOPASSWD: /usr/bin/python3 /app/providers/pi-fm/worker.py /home/pi/.local/share/fm-transmitter/job-*' > /etc/sudoers.d/biomerte-fm \
    && chmod 0440 /etc/sudoers.d/biomerte-fm \
    && visudo -cf /etc/sudoers.d/biomerte-fm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BIOMERTE_RADIO_KIND=fm \
    BIOMERTE_FM_BACKEND_MANIFEST=/usr/local/lib/biomerte/fm-backend.json
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "python3", "/app/deploy/workers/radio/entrypoint.py"]
CMD ["check"]
