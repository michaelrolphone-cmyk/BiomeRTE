ARG DEBIAN_IMAGE=debian@sha256:50b15ac0f2b79ba71bad6a3c7606e992c4cc3213aa9b47700efebe7e8678931f
FROM ${DEBIAN_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-numpy python3-serial librtlsdr0 libusb-1.0-0 \
    openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 pi && useradd -u 1000 -g 1000 -m pi \
    && mkdir -p /run/biomerte && chown 1000:1000 /run/biomerte
WORKDIR /app
COPY biomerte /app/biomerte
COPY providers/pi-sdr /app/providers/pi-sdr
COPY deploy/workers/radio/entrypoint.py deploy/workers/radio/launch.py /app/deploy/workers/radio/
COPY deploy/workers/radio/tests /app/deploy/workers/radio/tests
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BIOMERTE_RADIO_KIND=sdr
RUN chmod -R a+rX /app
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "python3", "/app/deploy/workers/radio/entrypoint.py"]
CMD ["check"]
