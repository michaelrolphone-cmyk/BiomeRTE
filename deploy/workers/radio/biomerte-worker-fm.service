[Unit]
Description=Containerized actual Pi GPIO4 FM implementation
Requires=docker.service
After=docker.service network-online.target
Conflicts=biomerte-fm.service biomerte-fm-provider.service

[Service]
ExecStart=/usr/bin/python3 /opt/biomerte/deploy/workers/radio/launch.py run --config /etc/biomerte/worker-fm.json
ExecStop=/usr/bin/docker stop --time 30 biomerte-worker-fm
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
