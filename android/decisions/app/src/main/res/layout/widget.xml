<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@drawable/widget_background" android:clipToOutline="true">
 <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DECISIONS" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:textColor="@color/accent" android:textSize="13sp"/>
 <TextView android:id="@+id/response_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="2" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
 <ListView android:id="@+id/choices" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:scrollbarStyle="insideOverlay" android:listSelector="@android:color/transparent"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
  <Button android:id="@+id/other" android:background="@drawable/widget_toolbar_background" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="@color/accent" android:fontFamily="sans-serif-medium" android:minWidth="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Write reply…" android:textAllCaps="false" android:textSize="14sp"/>
  <Button android:id="@+id/next" android:background="@drawable/widget_toolbar_background" android:backgroundTint="@null" android:stateListAnimator="@null" android:textColor="@color/accent" android:fontFamily="sans-serif-medium" android:minWidth="0dp" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingHorizontal="8dp" android:text="Next question" android:textSize="13sp" android:contentDescription="Next question"/>
 </LinearLayout>
 <TextView android:id="@+id/connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp" android:maxLines="1"/>
</LinearLayout>
