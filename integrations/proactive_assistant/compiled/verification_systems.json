{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "verification_systems__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "verification_systems__start": {
      "type": "set",
      "values": {},
      "next": "verification_systems__next"
    },
    "verification_systems__next": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "gateway": "next",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "verification_systems__next_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "verification_systems__next_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "verification_systems__check"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "verification_systems__end"
        }
      ],
      "default": "verification_systems__return_unresolved"
    },
    "verification_systems__check": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "task": "check",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "verification_systems__check_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "verification_systems__check_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "verification_systems__check_resolved"
    },
    "verification_systems__check_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "verification_systems__check_resolved_result"
        }
      ],
      "default": "verification_systems__check_call"
    },
    "verification_systems__check_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "verification_systems__check_merge"
    },
    "verification_systems__check_call": {
      "type": "call",
      "process": "assistant.execution",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "verification_systems__check_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "verification_systems__check_merge": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "task": "check",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "verification_systems__check_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "verification_systems__check_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "verification_systems__check__disposition"
    },
    "verification_systems__retain": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "task": "retain",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "verification_systems__retain_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "verification_systems__retain_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "verification_systems__retain_accept"
        }
      ],
      "default": "propagate"
    },
    "verification_systems__retain_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "verification_systems__harm"
    },
    "verification_systems__harm": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "gateway": "harm",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "verification_systems__harm_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "verification_systems__harm_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "verification_systems__unsafe"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "verification_systems__next"
        }
      ],
      "default": "verification_systems__return_unresolved"
    },
    "verification_systems__unsafe": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "unsafe",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__unsafe_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__unsafe_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__end": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__check__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "verification_systems__retain"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "verification_systems__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "verification_systems__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "verification_systems__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "verification_systems__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "verification_systems__return_faulted"
        }
      ],
      "default": "verification_systems__return_unresolved"
    },
    "verification_systems__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "verification_systems__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "verification_systems__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "verification_systems__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "verification_systems",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
