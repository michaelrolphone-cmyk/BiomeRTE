{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "project__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "project__start": {
      "type": "set",
      "values": {},
      "next": "project__bootstrap"
    },
    "project__bootstrap": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "task": "bootstrap",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "project__bootstrap_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "project__bootstrap_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "project__bootstrap_resolved"
    },
    "project__bootstrap_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "project__bootstrap_resolved_result"
        }
      ],
      "default": "project__bootstrap_call"
    },
    "project__bootstrap_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "project__bootstrap_merge"
    },
    "project__bootstrap_call": {
      "type": "call",
      "process": "assistant.bootstrap",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "project__bootstrap_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "project__bootstrap_merge": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "task": "bootstrap",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "project__bootstrap_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "project__bootstrap_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "project__bootstrap_disposition"
    },
    "project__qualify": {
      "type": "service",
