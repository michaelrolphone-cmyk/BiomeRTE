              true
            ]
          },
          "to": "project__admit_resolved_result"
        }
      ],
      "default": "project__admit_call"
    },
    "project__admit_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "project__admit_merge"
    },
    "project__admit_call": {
      "type": "call",
      "process": "assistant.cycle_admission",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "project__admit_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "project__admit_merge": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "task": "admit",
        "child": {
          "$": "child_result"
        },
        "frame": {
