      }
    },
    "project__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "project__return_unresolved_end",
