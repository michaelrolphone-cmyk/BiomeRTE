        "$": "result"
      }
    },
    "project__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "project__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "project__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "project__qualify_disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "project__register"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
