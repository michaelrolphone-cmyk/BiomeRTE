    },
    "project__end": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "project__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "project__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "project__bootstrap_disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "project__qualify"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "project__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "project__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "project__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "project__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "project__return_faulted"
        }
      ],
      "default": "project__return_unresolved"
    },
    "project__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "project__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "project__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "project__return_deferred": {
      "type": "service",
