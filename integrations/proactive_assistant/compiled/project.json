    },
    "project__register_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "project__register_resolved"
    },
    "project__register_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
