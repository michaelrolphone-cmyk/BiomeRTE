    "project__register_merge": {
      "type": "service",
      "args": {
        "logical_process": "project",
        "task": "register",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "project__register_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "project__register_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
