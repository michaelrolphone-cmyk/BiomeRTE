{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "reconcile__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "reconcile__start": {
      "type": "set",
      "values": {},
      "next": "reconcile__read"
    },
    "reconcile__read": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "task": "read",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "reconcile__read_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "reconcile__read_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "reconcile__read_accept"
        }
      ],
      "default": "propagate"
    },
    "reconcile__read_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "reconcile__route"
    },
    "reconcile__route": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "gateway": "route",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "reconcile__route_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "reconcile__route_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "reconcile__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "reconcile__fault"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "reconcile__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              3
            ]
          },
          "to": "reconcile__inspect"
        }
      ],
      "default": "reconcile__return_unresolved"
    },
    "reconcile__inspect": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "task": "inspect",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "reconcile__inspect_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "reconcile__inspect_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "reconcile__inspect_accept"
        }
      ],
      "default": "propagate"
    },
    "reconcile__inspect_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "reconcile__known"
    },
    "reconcile__known": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "gateway": "known",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "reconcile__known_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "reconcile__known_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "reconcile__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "reconcile__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "reconcile__unresolved"
        }
      ],
      "default": "reconcile__return_unresolved"
    },
    "reconcile__end": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "reconcile__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "reconcile__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "reconcile__pending": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "terminal": "pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.wait",
      "next": "reconcile__pending_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "reconcile__pending_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "reconcile__pending_resume"
        }
      ],
      "default": "propagate"
    },
    "reconcile__pending_resume": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "reconcile__read"
    },
    "reconcile__unresolved": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "terminal": "unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "reconcile__unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "reconcile__unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "reconcile__fault": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "terminal": "fault",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "reconcile__fault_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "reconcile__fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "reconcile__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "reconcile__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "reconcile__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "reconcile",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
