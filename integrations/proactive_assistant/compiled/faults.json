{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "faults__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "faults__start": {
      "type": "set",
      "values": {},
      "next": "faults__classify"
    },
    "faults__classify": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "task": "classify",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "faults__classify_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "faults__classify_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "faults__classify_accept"
        }
      ],
      "default": "propagate"
    },
    "faults__classify_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "faults__route"
    },
    "faults__route": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "gateway": "route",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "faults__route_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "faults__route_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "faults__reconcile"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "faults__record"
        }
      ],
      "default": "faults__return_unresolved"
    },
    "faults__reconcile": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "task": "reconcile",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "faults__reconcile_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "faults__reconcile_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "faults__reconcile_resolved"
    },
    "faults__reconcile_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "faults__reconcile_resolved_result"
        }
      ],
      "default": "faults__reconcile_call"
    },
    "faults__reconcile_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "faults__reconcile_merge"
    },
    "faults__reconcile_call": {
      "type": "call",
      "process": "assistant.reconcile",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "faults__reconcile_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "faults__reconcile_merge": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "task": "reconcile",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "faults__reconcile_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "faults__reconcile_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "faults__reconcile__disposition"
    },
    "faults__record": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "task": "record",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "faults__record_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "faults__record_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "faults__record_accept"
        }
      ],
      "default": "propagate"
    },
    "faults__record_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "faults__end"
    },
    "faults__end": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "faults__reconcile__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "faults__record"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "faults__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "faults__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "faults__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "faults__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "faults__return_faulted"
        }
      ],
      "default": "faults__return_unresolved"
    },
    "faults__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "faults__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "faults__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "faults__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "faults__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "faults__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "faults__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "faults",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
