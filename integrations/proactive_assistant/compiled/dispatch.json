{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "dispatch__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "dispatch__start": {
      "type": "set",
      "values": {},
      "next": "dispatch__intent"
    },
    "dispatch__intent": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "task": "intent",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "dispatch__intent_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "dispatch__intent_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "dispatch__intent_accept"
        }
      ],
      "default": "propagate"
    },
    "dispatch__intent_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "dispatch__guard"
    },
    "dispatch__guard": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "task": "guard",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "dispatch__guard_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "dispatch__guard_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "dispatch__guard_resolved"
    },
    "dispatch__guard_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "dispatch__guard_resolved_result"
        }
      ],
      "default": "dispatch__guard_call"
    },
    "dispatch__guard_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "dispatch__guard_merge"
    },
    "dispatch__guard_call": {
      "type": "call",
      "process": "assistant.governed",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "dispatch__guard_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "dispatch__guard_merge": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "task": "guard",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "dispatch__guard_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "dispatch__guard_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "dispatch__guard__disposition"
    },
    "dispatch__receipt": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "task": "receipt",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "dispatch__receipt_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "dispatch__receipt_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "dispatch__receipt_accept"
        }
      ],
      "default": "propagate"
    },
    "dispatch__receipt_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "dispatch__end"
    },
    "dispatch__end": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "dispatch__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "dispatch__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "dispatch__release": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "task": "release",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "dispatch__release_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "dispatch__release_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "dispatch__release_accept"
        }
      ],
      "default": "propagate"
    },
    "dispatch__release_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "dispatch__aborted"
    },
    "dispatch__guard__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "dispatch__receipt"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "dispatch__release"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "dispatch__release"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "dispatch__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "dispatch__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "dispatch__return_faulted"
        }
      ],
      "default": "dispatch__return_unresolved"
    },
    "dispatch__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "dispatch__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "dispatch__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "dispatch__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "dispatch__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "dispatch__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "dispatch__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "dispatch__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "dispatch__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "dispatch__aborted": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "terminal": "aborted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "dispatch__aborted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "dispatch__aborted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "dispatch",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
