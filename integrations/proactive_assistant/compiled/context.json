{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "context__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "context__start": {
      "type": "set",
      "values": {},
      "next": "context__read"
    },
    "context__read": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "task": "read",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "context__read_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "context__read_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "context__read_resolved"
    },
    "context__read_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "context__read_resolved_result"
        }
      ],
      "default": "context__read_call"
    },
    "context__read_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "context__read_merge"
    },
    "context__read_call": {
      "type": "call",
      "process": "assistant.access",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "context__read_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "context__read_merge": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "task": "read",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "context__read_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "context__read_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "context__read__disposition"
    },
    "context__fresh": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "task": "fresh",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "context__fresh_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "context__fresh_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "context__fresh_accept"
        }
      ],
      "default": "propagate"
    },
    "context__fresh_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "context__select"
    },
    "context__select": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "task": "select",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "context__select_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "context__select_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "context__select_accept"
        }
      ],
      "default": "propagate"
    },
    "context__select_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "context__fit"
    },
    "context__fit": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "gateway": "fit",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "context__fit_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "context__fit_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "context__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "context__compress"
        }
      ],
      "default": "context__return_unresolved"
    },
    "context__compress": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "task": "compress",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "context__compress_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "context__compress_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "context__compress_accept"
        }
      ],
      "default": "propagate"
    },
    "context__compress_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "context__progress"
    },
    "context__progress": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "gateway": "progress",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "context__progress_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "context__progress_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "context__fit"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "context__larger"
        }
      ],
      "default": "context__return_unresolved"
    },
    "context__end": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__larger": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "larger",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__larger_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__larger_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__read__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "context__fresh"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "context__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "context__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "context__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "context__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "context__return_faulted"
        }
      ],
      "default": "context__return_unresolved"
    },
    "context__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "context__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "context__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "context__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "context",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
