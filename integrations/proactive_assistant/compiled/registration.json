{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "registration__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "registration__start": {
      "type": "set",
      "values": {},
      "next": "registration__intent"
    },
    "registration__intent": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "task": "intent",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "registration__intent_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "registration__intent_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "registration__intent_accept"
        }
      ],
      "default": "propagate"
    },
    "registration__intent_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "registration__apply"
    },
    "registration__apply": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "task": "apply",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "registration__apply_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "registration__apply_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "registration__apply_resolved"
    },
    "registration__apply_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "registration__apply_resolved_result"
        }
      ],
      "default": "registration__apply_call"
    },
    "registration__apply_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "registration__apply_merge"
    },
    "registration__apply_call": {
      "type": "call",
      "process": "assistant.governed",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "registration__apply_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "registration__apply_merge": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "task": "apply",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "registration__apply_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "registration__apply_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "registration__apply_disposition"
    },
    "registration__read": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "task": "read",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "registration__read_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "registration__read_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "registration__read_accept"
        }
      ],
      "default": "propagate"
    },
    "registration__read_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "registration__state"
    },
    "registration__state": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "gateway": "state",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "registration__state_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "registration__state_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "registration__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "registration__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "registration__conflict"
        }
      ],
      "default": "registration__return_unresolved"
    },
    "registration__end": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__pending": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.wait",
      "next": "registration__pending_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "registration__pending_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "registration__pending_resume"
        }
      ],
      "default": "propagate"
    },
    "registration__pending_resume": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "registration__read"
    },
    "registration__conflict": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "conflict",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__conflict_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__conflict_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__apply_disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "registration__read"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "registration__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "registration__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "registration__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "registration__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "registration__return_faulted"
        }
      ],
      "default": "registration__return_unresolved"
    },
    "registration__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "registration__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "registration__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "registration__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "registration",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
