{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "judgment__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "judgment__start": {
      "type": "set",
      "values": {},
      "next": "judgment__question"
    },
    "judgment__question": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "task": "question",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "judgment__question_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "judgment__question_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "judgment__question_accept"
        }
      ],
      "default": "propagate"
    },
    "judgment__question_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "judgment__submit"
    },
    "judgment__submit": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "task": "submit",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "judgment__submit_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "judgment__submit_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "judgment__submit_accept"
        }
      ],
      "default": "propagate"
    },
    "judgment__submit_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "judgment__response"
    },
    "judgment__response": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "gateway": "response",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "judgment__response_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "judgment__response_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "judgment__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "judgment__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "judgment__defer"
        }
      ],
      "default": "judgment__return_unresolved"
    },
    "judgment__end": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "judgment__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "judgment__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "judgment__pending": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "terminal": "pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.wait",
      "next": "judgment__pending_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "judgment__pending_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "judgment__pending_resume"
        }
      ],
      "default": "propagate"
    },
    "judgment__pending_resume": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "judgment__submit"
    },
    "judgment__defer": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "terminal": "defer",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "judgment__defer_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "judgment__defer_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "judgment__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "judgment__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "judgment__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "judgment",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
