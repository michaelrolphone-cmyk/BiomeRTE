{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "workspace_resume",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "workspace_resume__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "workspace_resume__start": {
      "type": "set",
      "values": {},
      "next": "workspace_resume__acquire"
    },
    "workspace_resume__acquire": {
      "type": "service",
      "args": {
        "logical_process": "workspace_resume",
        "task": "acquire",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "workspace_resume__acquire_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "workspace_resume__acquire_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "workspace_resume__acquire_accept"
        }
      ],
      "default": "propagate"
    },
    "workspace_resume__acquire_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "workspace_resume__end"
    },
    "workspace_resume__end": {
      "type": "service",
      "args": {
        "logical_process": "workspace_resume",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "workspace_resume__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "workspace_resume__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "workspace_resume",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
