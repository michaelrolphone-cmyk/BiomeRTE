{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "investigation__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "investigation__start": {
      "type": "set",
      "values": {},
      "next": "investigation__scope"
    },
    "investigation__scope": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "task": "scope",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "investigation__scope_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "investigation__scope_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "investigation__scope_accept"
        }
      ],
      "default": "propagate"
    },
    "investigation__scope_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "investigation__separable"
    },
    "investigation__separable": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "gateway": "separable",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "investigation__separable_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "investigation__separable_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "investigation__execute"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "investigation__child"
        }
      ],
      "default": "investigation__return_unresolved"
    },
    "investigation__execute": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "task": "execute",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "investigation__execute_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "investigation__execute_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "investigation__execute_resolved"
    },
    "investigation__execute_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "investigation__execute_resolved_result"
        }
      ],
      "default": "investigation__execute_call"
    },
    "investigation__execute_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "investigation__execute_merge"
    },
    "investigation__execute_call": {
      "type": "call",
      "process": "assistant.execution",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "investigation__execute_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "investigation__execute_merge": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "task": "execute",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "investigation__execute_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "investigation__execute_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "investigation__execute__disposition"
    },
    "investigation__end": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__child": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "task": "child",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "investigation__child_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "investigation__child_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "investigation__child_resolved"
    },
    "investigation__child_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "investigation__child_resolved_result"
        }
      ],
      "default": "investigation__child_call"
    },
    "investigation__child_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "investigation__child_merge"
    },
    "investigation__child_call": {
      "type": "call",
      "process": "assistant.execution",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "investigation__child_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "investigation__child_merge": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "task": "child",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "investigation__child_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "investigation__child_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "investigation__child__disposition"
    },
    "investigation__pending": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.wait",
      "next": "investigation__pending_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "investigation__pending_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "investigation__pending_resume"
        }
      ],
      "default": "propagate"
    },
    "investigation__pending_resume": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "investigation__scope"
    },
    "investigation__execute__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "investigation__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "investigation__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "investigation__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "investigation__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "investigation__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "investigation__return_faulted"
        }
      ],
      "default": "investigation__return_unresolved"
    },
    "investigation__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "investigation__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "investigation__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "investigation__child__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "investigation__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "investigation__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "investigation__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "investigation__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "investigation__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "investigation__return_faulted"
        }
      ],
      "default": "investigation__return_unresolved"
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "investigation",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
