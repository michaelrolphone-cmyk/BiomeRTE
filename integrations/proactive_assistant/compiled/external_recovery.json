{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "external_recovery__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "external_recovery__start": {
      "type": "set",
      "values": {},
      "next": "external_recovery__validate"
    },
    "external_recovery__validate": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "task": "validate",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "external_recovery__validate_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "external_recovery__validate_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "external_recovery__validate_accept"
        }
      ],
      "default": "propagate"
    },
    "external_recovery__validate_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "external_recovery__allowed"
    },
    "external_recovery__allowed": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "gateway": "allowed",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "external_recovery__allowed_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "external_recovery__allowed_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "external_recovery__invoke"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "external_recovery__pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "external_recovery__reject"
        }
      ],
      "default": "external_recovery__return_unresolved"
    },
    "external_recovery__invoke": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "task": "invoke",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "external_recovery__invoke_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "external_recovery__invoke_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "external_recovery__invoke_accept"
        }
      ],
      "default": "propagate"
    },
    "external_recovery__invoke_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "external_recovery__receipt"
    },
    "external_recovery__receipt": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "gateway": "receipt",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "external_recovery__receipt_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "external_recovery__receipt_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "external_recovery__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "external_recovery__pending"
        }
      ],
      "default": "external_recovery__return_unresolved"
    },
    "external_recovery__end": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "external_recovery__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "external_recovery__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "external_recovery__pending": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "terminal": "pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "external_recovery__pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "external_recovery__pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "external_recovery__reject": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "terminal": "reject",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "external_recovery__reject_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "external_recovery__reject_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "external_recovery__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "external_recovery__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "external_recovery__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "external_recovery",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
