{
  "start": "entry",
  "nodes": {
    "entry": {
      "type": "start",
      "next": "input_frame"
    },
    "input_frame": {
      "type": "set",
      "values": {
        "frame": {
          "$": "input.frame"
        }
      },
      "next": "initialize"
    },
    "initialize": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "frame": {
          "$": "input.frame"
        }
      },
      "operation": "assistant.enter",
      "next": "planning__start",
      "save": "frame",
      "on_error": "fault_capture"
    },
    "planning__start": {
      "type": "set",
      "values": {},
      "next": "planning__read"
    },
    "planning__read": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "task": "read",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.before",
      "next": "planning__read_prepared",
      "save": "prepared",
      "on_error": "fault_capture"
    },
    "planning__read_prepared": {
      "type": "set",
      "values": {
        "frame": {
          "$": "prepared.frame"
        }
      },
      "next": "planning__read_resolved"
    },
    "planning__read_resolved": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "prepared.resolved"
              },
              true
            ]
          },
          "to": "planning__read_resolved_result"
        }
      ],
      "default": "planning__read_call"
    },
    "planning__read_resolved_result": {
      "type": "set",
      "values": {
        "child_result": {
          "$": "prepared.result"
        }
      },
      "next": "planning__read_merge"
    },
    "planning__read_call": {
      "type": "call",
      "process": "assistant.access",
      "args": {
        "frame": {
          "$": "frame"
        }
      },
      "next": "planning__read_merge",
      "save": "child_result",
      "on_error": "fault_capture"
    },
    "planning__read_merge": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "task": "read",
        "child": {
          "$": "child_result"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.child",
      "next": "planning__read_mapped",
      "save": "step",
      "on_error": "fault_capture"
    },
    "planning__read_mapped": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "planning__read__disposition"
    },
    "planning__rank": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "task": "rank",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "planning__rank_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "planning__rank_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "planning__rank_accept"
        }
      ],
      "default": "propagate"
    },
    "planning__rank_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "planning__fit"
    },
    "planning__fit": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "gateway": "fit",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "planning__fit_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "planning__fit_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "planning__reserve"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "planning__wait"
        }
      ],
      "default": "planning__return_unresolved"
    },
    "planning__reserve": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "task": "reserve",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.stage",
      "next": "planning__reserve_status",
      "save": "step",
      "on_error": "fault_capture"
    },
    "planning__reserve_status": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "step.disposition"
              },
              "completed"
            ]
          },
          "to": "planning__reserve_accept"
        }
      ],
      "default": "propagate"
    },
    "planning__reserve_accept": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        }
      },
      "next": "planning__reserved"
    },
    "planning__reserved": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "gateway": "reserved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.route",
      "next": "planning__reserved_select",
      "save": "route",
      "on_error": "fault_capture"
    },
    "planning__reserved_select": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              0
            ]
          },
          "to": "planning__end"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              1
            ]
          },
          "to": "planning__wait"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "route.index"
              },
              2
            ]
          },
          "to": "planning__conflict"
        }
      ],
      "default": "planning__return_unresolved"
    },
    "planning__end": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "end",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__end_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__end_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__wait": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "wait",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__wait_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__wait_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__conflict": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "conflict",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__conflict_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__conflict_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__read__disposition": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "completed"
            ]
          },
          "to": "planning__rank"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "rejected"
            ]
          },
          "to": "planning__return_rejected"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "deferred"
            ]
          },
          "to": "planning__return_deferred"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "pending"
            ]
          },
          "to": "planning__return_pending"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "unresolved"
            ]
          },
          "to": "planning__return_unresolved"
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "frame.last_disposition"
              },
              "faulted"
            ]
          },
          "to": "planning__return_faulted"
        }
      ],
      "default": "planning__return_unresolved"
    },
    "planning__return_rejected": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "return_rejected",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__return_rejected_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__return_rejected_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__return_deferred": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "return_deferred",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__return_deferred_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__return_deferred_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__return_pending": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "return_pending",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__return_pending_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__return_pending_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__return_unresolved": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "return_unresolved",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__return_unresolved_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__return_unresolved_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "planning__return_faulted": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "terminal": "return_faulted",
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.finish",
      "next": "planning__return_faulted_end",
      "save": "result",
      "on_error": "fault_capture"
    },
    "planning__return_faulted_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "propagate": {
      "type": "set",
      "values": {
        "frame": {
          "$": "step.frame"
        },
        "result": {
          "$": "step"
        }
      },
      "next": "propagate_end"
    },
    "propagate_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    },
    "fault_capture": {
      "type": "service",
      "args": {
        "logical_process": "planning",
        "error": {
          "$": "error"
        },
        "frame": {
          "$": "frame"
        }
      },
      "operation": "assistant.fault",
      "next": "fault_end",
      "save": "result"
    },
    "fault_end": {
      "type": "end",
      "result": {
        "$": "result"
      }
    }
  },
  "inputs": {
    "frame": "obj"
  },
  "outputs": {
    "disposition": "str",
    "result_code": "str",
    "data": "obj",
    "evidence_refs": "list",
    "continuation": "obj",
    "harm_status": "str",
    "origin": "obj",
    "frame": "obj"
  }
}
