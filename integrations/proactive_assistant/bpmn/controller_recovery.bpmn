<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.controller_recovery" name="Controller takeover and standing coverage" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Recover responsibilities after restart or failover with a new authoritative epoch.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="controller_recovery__start" b:set="{}" /><bpmn:serviceTask id="controller_recovery__authority" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;authority&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__authority_status" default="f7" /><bpmn:task id="controller_recovery__authority_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="controller_recovery__valid" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;gateway&quot;: &quot;valid&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__valid_select" default="f12" /><bpmn:serviceTask id="controller_recovery__scan" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;scan&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__scan_status" default="f15" /><bpmn:task id="controller_recovery__scan_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="controller_recovery__classify" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;gateway&quot;: &quot;classify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__classify_select" default="f21" /><bpmn:serviceTask id="controller_recovery__resume" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;resume&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__resume_status" default="f24" /><bpmn:task id="controller_recovery__resume_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="controller_recovery__admit" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;admit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="controller_recovery__admit_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="controller_recovery__admit_resolved" default="f29" /><bpmn:task id="controller_recovery__admit_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="controller_recovery__admit_call" calledElement="assistant.cycle_admission" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="controller_recovery__admit_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;admit&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="controller_recovery__admit_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="controller_recovery__wait" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;task&quot;: &quot;wait&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="controller_recovery__wait_status" default="f36" /><bpmn:task id="controller_recovery__wait_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="controller_recovery__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="controller_recovery__stale" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;stale&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__stale_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="controller_recovery__admit_disposition" default="f46" /><bpmn:serviceTask id="controller_recovery__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="controller_recovery__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="controller_recovery__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="controller_recovery__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="controller_recovery__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="controller_recovery__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;controller_recovery&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="controller_recovery__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="controller_recovery__start" targetRef="controller_recovery__authority" name="" /><bpmn:sequenceFlow id="f5" sourceRef="controller_recovery__authority" targetRef="controller_recovery__authority_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="controller_recovery__authority_status" targetRef="controller_recovery__authority_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="controller_recovery__authority_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="controller_recovery__authority_accept" targetRef="controller_recovery__valid" name="" /><bpmn:sequenceFlow id="f9" sourceRef="controller_recovery__valid" targetRef="controller_recovery__valid_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="controller_recovery__valid_select" targetRef="controller_recovery__scan" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="controller_recovery__valid_select" targetRef="controller_recovery__stale" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="controller_recovery__valid_select" targetRef="controller_recovery__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="controller_recovery__scan" targetRef="controller_recovery__scan_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="controller_recovery__scan_status" targetRef="controller_recovery__scan_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="controller_recovery__scan_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="controller_recovery__scan_accept" targetRef="controller_recovery__classify" name="" /><bpmn:sequenceFlow id="f17" sourceRef="controller_recovery__classify" targetRef="controller_recovery__classify_select" name="" /><bpmn:sequenceFlow id="f18" sourceRef="controller_recovery__classify_select" targetRef="controller_recovery__resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="controller_recovery__classify_select" targetRef="controller_recovery__admit" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="controller_recovery__classify_select" targetRef="controller_recovery__wait" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="controller_recovery__classify_select" targetRef="controller_recovery__return_unresolved" name="" /><bpmn:sequenceFlow id="f22" sourceRef="controller_recovery__resume" targetRef="controller_recovery__resume_status" name="" /><bpmn:sequenceFlow id="f23" sourceRef="controller_recovery__resume_status" targetRef="controller_recovery__resume_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="controller_recovery__resume_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f25" sourceRef="controller_recovery__resume_accept" targetRef="controller_recovery__end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="controller_recovery__admit" targetRef="controller_recovery__admit_prepared" name="" /><bpmn:sequenceFlow id="f27" sourceRef="controller_recovery__admit_prepared" targetRef="controller_recovery__admit_resolved" name="" /><bpmn:sequenceFlow id="f28" sourceRef="controller_recovery__admit_resolved" targetRef="controller_recovery__admit_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="controller_recovery__admit_resolved" targetRef="controller_recovery__admit_call" name="" /><bpmn:sequenceFlow id="f30" sourceRef="controller_recovery__admit_resolved_result" targetRef="controller_recovery__admit_merge" name="" /><bpmn:sequenceFlow id="f31" sourceRef="controller_recovery__admit_call" targetRef="controller_recovery__admit_merge" name="" /><bpmn:sequenceFlow id="f32" sourceRef="controller_recovery__admit_merge" targetRef="controller_recovery__admit_mapped" name="" /><bpmn:sequenceFlow id="f33" sourceRef="controller_recovery__admit_mapped" targetRef="controller_recovery__admit_disposition" name="" /><bpmn:sequenceFlow id="f34" sourceRef="controller_recovery__wait" targetRef="controller_recovery__wait_status" name="" /><bpmn:sequenceFlow id="f35" sourceRef="controller_recovery__wait_status" targetRef="controller_recovery__wait_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="controller_recovery__wait_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f37" sourceRef="controller_recovery__wait_accept" targetRef="controller_recovery__end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="controller_recovery__end" targetRef="controller_recovery__end_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="controller_recovery__stale" targetRef="controller_recovery__stale_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f41" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f42" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f43" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f44" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f45" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f46" sourceRef="controller_recovery__admit_disposition" targetRef="controller_recovery__return_unresolved" name="" /><bpmn:sequenceFlow id="f47" sourceRef="controller_recovery__return_rejected" targetRef="controller_recovery__return_rejected_end" name="" /><bpmn:sequenceFlow id="f48" sourceRef="controller_recovery__return_deferred" targetRef="controller_recovery__return_deferred_end" name="" /><bpmn:sequenceFlow id="f49" sourceRef="controller_recovery__return_pending" targetRef="controller_recovery__return_pending_end" name="" /><bpmn:sequenceFlow id="f50" sourceRef="controller_recovery__return_unresolved" targetRef="controller_recovery__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f51" sourceRef="controller_recovery__return_faulted" targetRef="controller_recovery__return_faulted_end" name="" /><bpmn:sequenceFlow id="f52" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f53" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>