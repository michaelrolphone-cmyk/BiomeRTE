<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.impact" name="Sequential cross-system impact review" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Ask the checklist against every system individually and revisit newly discovered dependencies.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="impact__start" b:set="{}" /><bpmn:serviceTask id="impact__queue" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;task&quot;: &quot;queue&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="impact__queue_status" default="f7" /><bpmn:task id="impact__queue_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="impact__system" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;task&quot;: &quot;system&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="impact__system_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="impact__system_resolved" default="f12" /><bpmn:task id="impact__system_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="impact__system_call" calledElement="assistant.system_review" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="impact__system_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;task&quot;: &quot;system&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="impact__system_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="impact__refresh" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;task&quot;: &quot;refresh&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="impact__refresh_status" default="f19" /><bpmn:task id="impact__refresh_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="impact__more" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;gateway&quot;: &quot;more&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="impact__more_select" default="f24" /><bpmn:serviceTask id="impact__coverage" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;task&quot;: &quot;coverage&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="impact__coverage_status" default="f27" /><bpmn:task id="impact__coverage_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="impact__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="impact__system__disposition" default="f36" /><bpmn:serviceTask id="impact__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="impact__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="impact__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="impact__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="impact__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="impact__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;impact&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="impact__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="impact__start" targetRef="impact__queue" name="" /><bpmn:sequenceFlow id="f5" sourceRef="impact__queue" targetRef="impact__queue_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="impact__queue_status" targetRef="impact__queue_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="impact__queue_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="impact__queue_accept" targetRef="impact__system" name="" /><bpmn:sequenceFlow id="f9" sourceRef="impact__system" targetRef="impact__system_prepared" name="" /><bpmn:sequenceFlow id="f10" sourceRef="impact__system_prepared" targetRef="impact__system_resolved" name="" /><bpmn:sequenceFlow id="f11" sourceRef="impact__system_resolved" targetRef="impact__system_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="impact__system_resolved" targetRef="impact__system_call" name="" /><bpmn:sequenceFlow id="f13" sourceRef="impact__system_resolved_result" targetRef="impact__system_merge" name="" /><bpmn:sequenceFlow id="f14" sourceRef="impact__system_call" targetRef="impact__system_merge" name="" /><bpmn:sequenceFlow id="f15" sourceRef="impact__system_merge" targetRef="impact__system_mapped" name="" /><bpmn:sequenceFlow id="f16" sourceRef="impact__system_mapped" targetRef="impact__system__disposition" name="" /><bpmn:sequenceFlow id="f17" sourceRef="impact__refresh" targetRef="impact__refresh_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="impact__refresh_status" targetRef="impact__refresh_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="impact__refresh_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="impact__refresh_accept" targetRef="impact__more" name="" /><bpmn:sequenceFlow id="f21" sourceRef="impact__more" targetRef="impact__more_select" name="" /><bpmn:sequenceFlow id="f22" sourceRef="impact__more_select" targetRef="impact__system" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="impact__more_select" targetRef="impact__coverage" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="impact__more_select" targetRef="impact__return_unresolved" name="" /><bpmn:sequenceFlow id="f25" sourceRef="impact__coverage" targetRef="impact__coverage_status" name="" /><bpmn:sequenceFlow id="f26" sourceRef="impact__coverage_status" targetRef="impact__coverage_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="impact__coverage_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f28" sourceRef="impact__coverage_accept" targetRef="impact__end" name="" /><bpmn:sequenceFlow id="f29" sourceRef="impact__end" targetRef="impact__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="impact__system__disposition" targetRef="impact__refresh" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="impact__system__disposition" targetRef="impact__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="impact__system__disposition" targetRef="impact__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="impact__system__disposition" targetRef="impact__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="impact__system__disposition" targetRef="impact__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="impact__system__disposition" targetRef="impact__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="impact__system__disposition" targetRef="impact__return_unresolved" name="" /><bpmn:sequenceFlow id="f37" sourceRef="impact__return_rejected" targetRef="impact__return_rejected_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="impact__return_deferred" targetRef="impact__return_deferred_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="impact__return_pending" targetRef="impact__return_pending_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="impact__return_unresolved" targetRef="impact__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="impact__return_faulted" targetRef="impact__return_faulted_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>