<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.context" name="Context retrieval and fitting" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Assemble focused context and yield when it cannot be reduced safely.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="context__start" b:set="{}" /><bpmn:serviceTask id="context__read" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="context__read_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="context__read_resolved" default="f8" /><bpmn:task id="context__read_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="context__read_call" calledElement="assistant.access" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="context__read_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;task&quot;: &quot;read&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="context__read_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="context__fresh" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;task&quot;: &quot;fresh&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="context__fresh_status" default="f15" /><bpmn:task id="context__fresh_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="context__select" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;task&quot;: &quot;select&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="context__select_status" default="f19" /><bpmn:task id="context__select_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="context__fit" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;gateway&quot;: &quot;fit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="context__fit_select" default="f24" /><bpmn:serviceTask id="context__compress" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;task&quot;: &quot;compress&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="context__compress_status" default="f27" /><bpmn:task id="context__compress_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="context__progress" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;gateway&quot;: &quot;progress&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="context__progress_select" default="f32" /><bpmn:serviceTask id="context__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="context__larger" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;larger&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__larger_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="context__read__disposition" default="f41" /><bpmn:serviceTask id="context__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="context__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="context__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="context__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="context__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="context__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;context&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="context__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="context__start" targetRef="context__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="context__read" targetRef="context__read_prepared" name="" /><bpmn:sequenceFlow id="f6" sourceRef="context__read_prepared" targetRef="context__read_resolved" name="" /><bpmn:sequenceFlow id="f7" sourceRef="context__read_resolved" targetRef="context__read_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f8" sourceRef="context__read_resolved" targetRef="context__read_call" name="" /><bpmn:sequenceFlow id="f9" sourceRef="context__read_resolved_result" targetRef="context__read_merge" name="" /><bpmn:sequenceFlow id="f10" sourceRef="context__read_call" targetRef="context__read_merge" name="" /><bpmn:sequenceFlow id="f11" sourceRef="context__read_merge" targetRef="context__read_mapped" name="" /><bpmn:sequenceFlow id="f12" sourceRef="context__read_mapped" targetRef="context__read__disposition" name="" /><bpmn:sequenceFlow id="f13" sourceRef="context__fresh" targetRef="context__fresh_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="context__fresh_status" targetRef="context__fresh_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="context__fresh_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="context__fresh_accept" targetRef="context__select" name="" /><bpmn:sequenceFlow id="f17" sourceRef="context__select" targetRef="context__select_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="context__select_status" targetRef="context__select_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="context__select_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="context__select_accept" targetRef="context__fit" name="" /><bpmn:sequenceFlow id="f21" sourceRef="context__fit" targetRef="context__fit_select" name="" /><bpmn:sequenceFlow id="f22" sourceRef="context__fit_select" targetRef="context__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="context__fit_select" targetRef="context__compress" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="context__fit_select" targetRef="context__return_unresolved" name="" /><bpmn:sequenceFlow id="f25" sourceRef="context__compress" targetRef="context__compress_status" name="" /><bpmn:sequenceFlow id="f26" sourceRef="context__compress_status" targetRef="context__compress_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="context__compress_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f28" sourceRef="context__compress_accept" targetRef="context__progress" name="" /><bpmn:sequenceFlow id="f29" sourceRef="context__progress" targetRef="context__progress_select" name="" /><bpmn:sequenceFlow id="f30" sourceRef="context__progress_select" targetRef="context__fit" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="context__progress_select" targetRef="context__larger" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="context__progress_select" targetRef="context__return_unresolved" name="" /><bpmn:sequenceFlow id="f33" sourceRef="context__end" targetRef="context__end_end" name="" /><bpmn:sequenceFlow id="f34" sourceRef="context__larger" targetRef="context__larger_end" name="" /><bpmn:sequenceFlow id="f35" sourceRef="context__read__disposition" targetRef="context__fresh" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="context__read__disposition" targetRef="context__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="context__read__disposition" targetRef="context__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="context__read__disposition" targetRef="context__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f39" sourceRef="context__read__disposition" targetRef="context__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f40" sourceRef="context__read__disposition" targetRef="context__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f41" sourceRef="context__read__disposition" targetRef="context__return_unresolved" name="" /><bpmn:sequenceFlow id="f42" sourceRef="context__return_rejected" targetRef="context__return_rejected_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="context__return_deferred" targetRef="context__return_deferred_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="context__return_pending" targetRef="context__return_pending_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="context__return_unresolved" targetRef="context__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f46" sourceRef="context__return_faulted" targetRef="context__return_faulted_end" name="" /><bpmn:sequenceFlow id="f47" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f48" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>