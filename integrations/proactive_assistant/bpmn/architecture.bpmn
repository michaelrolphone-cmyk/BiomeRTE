n></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="architecture__ownership_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="architecture__ownership_accept" targetRef="architecture__compare" name="" /><bpmn:sequenceFlow id="f25" sourceRef="architecture__compare" targetRef="architecture__compare_status" name="" /><bpmn:sequenceFlow id="f26" sourceRef="architecture__compare_status" targetRef="architecture__compare_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="architecture__compare_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f28" sourceRef="architecture__compare_accept" targetRef="architecture__end" name="" /><bpmn:sequenceFlow id="f29" sourceRef="architecture__end" targetRef="architecture__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>