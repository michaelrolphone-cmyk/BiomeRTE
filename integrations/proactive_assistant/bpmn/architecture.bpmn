<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.architecture" name="Tool reuse and architectural health" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Compare existing tooling, extensions and new generalized capabilities without a predetermined winner.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="architecture__start" b:set="{}" /><bpmn:serviceTask id="architecture__existing" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;existing&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__existing_status" default="f7" /><bpmn:task id="architecture__existing_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__general" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;general&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__general_status" default="f11" /><bpmn:task id="architecture__general_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__extension" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;extension&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__extension_status" default="f15" /><bpmn:task id="architecture__extension_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__parallel" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;parallel&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__parallel_status" default="f19" /><bpmn:task id="architecture__parallel_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__ownership" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;ownership&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__ownership_status" default="f23" /><bpmn:task id="architecture__ownership_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__compare" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;task&quot;: &quot;compare&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="architecture__compare_status" default="f27" /><bpmn:task id="architecture__compare_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="architecture__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="architecture__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;architecture&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="architecture__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="architecture__start" targetRef="architecture__existing" name="" /><bpmn:sequenceFlow id="f5" sourceRef="architecture__existing" targetRef="architecture__existing_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="architecture__existing_status" targetRef="architecture__existing_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="architecture__existing_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="architecture__existing_accept" targetRef="architecture__general" name="" /><bpmn:sequenceFlow id="f9" sourceRef="architecture__general" targetRef="architecture__general_status" name="" /><b