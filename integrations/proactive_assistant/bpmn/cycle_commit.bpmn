<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.cycle_commit" name="Atomic cycle finalization and successor" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Couple cycle completion, checkpoint and future responsibility coverage in one durable transaction.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="cycle_commit__start" b:set="{}" /><bpmn:serviceTask id="cycle_commit__read" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__read_status" default="f7" /><bpmn:task id="cycle_commit__read_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_commit__already" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;gateway&quot;: &quot;already&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__already_select" default="f12" /><bpmn:serviceTask id="cycle_commit__existing" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;existing&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_commit__existing_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_commit__plan" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;task&quot;: &quot;plan&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__plan_status" default="f16" /><bpmn:task id="cycle_commit__plan_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_commit__transaction" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;task&quot;: &quot;transaction&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__transaction_status" default="f20" /><bpmn:task id="cycle_commit__transaction_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_commit__result" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;gateway&quot;: &quot;result&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__result_select" default="f27" /><bpmn:serviceTask id="cycle_commit__verify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;task&quot;: &quot;verify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__verify_status" default="f30" /><bpmn:task id="cycle_commit__verify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_commit__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_commit__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_commit__conflict" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;conflict&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_commit__conflict_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_commit__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_commit__pending_status" default="f36" /><bpmn:task id="cycle_commit__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_commit__stale" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;stale&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_commit__stale_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_commit__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_commit__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;cycle_commit&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="cycle_commit__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="cycle_commit__start" targetRef="cycle_commit__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="cycle_commit__read" targetRef="cycle_commit__read_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="cycle_commit__read_status" targetRef="cycle_commit__read_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="cycle_commit__read_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="cycle_commit__read_accept" targetRef="cycle_commit__already" name="" /><bpmn:sequenceFlow id="f9" sourceRef="cycle_commit__already" targetRef="cycle_commit__already_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="cycle_commit__already_select" targetRef="cycle_commit__existing" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="cycle_commit__already_select" targetRef="cycle_commit__plan" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="cycle_commit__already_select" targetRef="cycle_commit__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="cycle_commit__existing" targetRef="cycle_commit__existing_end" name="" /><bpmn:sequenceFlow id="f14" sourceRef="cycle_commit__plan" targetRef="cycle_commit__plan_status" name="" /><bpmn:sequenceFlow id="f15" sourceRef="cycle_commit__plan_status" targetRef="cycle_commit__plan_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="cycle_commit__plan_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f17" sourceRef="cycle_commit__plan_accept" targetRef="cycle_commit__transaction" name="" /><bpmn:sequenceFlow id="f18" sourceRef="cycle_commit__transaction" targetRef="cycle_commit__transaction_status" name="" /><bpmn:sequenceFlow id="f19" sourceRef="cycle_commit__transaction_status" targetRef="cycle_commit__transaction_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="cycle_commit__transaction_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f21" sourceRef="cycle_commit__transaction_accept" targetRef="cycle_commit__result" name="" /><bpmn:sequenceFlow id="f22" sourceRef="cycle_commit__result" targetRef="cycle_commit__result_select" name="" /><bpmn:sequenceFlow id="f23" sourceRef="cycle_commit__result_select" targetRef="cycle_commit__verify" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="cycle_commit__result_select" targetRef="cycle_commit__conflict" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f25" sourceRef="cycle_commit__result_select" targetRef="cycle_commit__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f26" sourceRef="cycle_commit__result_select" targetRef="cycle_commit__stale" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 3]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="cycle_commit__result_select" targetRef="cycle_commit__return_unresolved" name="" /><bpmn:sequenceFlow id="f28" sourceRef="cycle_commit__verify" targetRef="cycle_commit__verify_status" name="" /><bpmn:sequenceFlow id="f29" sourceRef="cycle_commit__verify_status" targetRef="cycle_commit__verify_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f30" sourceRef="cycle_commit__verify_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f31" sourceRef="cycle_commit__verify_accept" targetRef="cycle_commit__end" name="" /><bpmn:sequenceFlow id="f32" sourceRef="cycle_commit__end" targetRef="cycle_commit__end_end" name="" /><bpmn:sequenceFlow id="f33" sourceRef="cycle_commit__conflict" targetRef="cycle_commit__conflict_end" name="" /><bpmn:sequenceFlow id="f34" sourceRef="cycle_commit__pending" targetRef="cycle_commit__pending_status" name="" /><bpmn:sequenceFlow id="f35" sourceRef="cycle_commit__pending_status" targetRef="cycle_commit__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="cycle_commit__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f37" sourceRef="cycle_commit__pending_resume" targetRef="cycle_commit__read" name="" /><bpmn:sequenceFlow id="f38" sourceRef="cycle_commit__stale" targetRef="cycle_commit__stale_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="cycle_commit__return_unresolved" targetRef="cycle_commit__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>