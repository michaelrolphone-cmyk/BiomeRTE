<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.bootstrap" name="Authority bootstrap and preflight" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Separate installed protocol authority from agent action permissions without a self-authorization loop.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="bootstrap__start" b:set="{}" /><bpmn:serviceTask id="bootstrap__transport" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;task&quot;: &quot;transport&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="bootstrap__transport_status" default="f7" /><bpmn:task id="bootstrap__transport_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="bootstrap__present" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;gateway&quot;: &quot;present&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="bootstrap__present_select" default="f12" /><bpmn:serviceTask id="bootstrap__permissions" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;task&quot;: &quot;permissions&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="bootstrap__permissions_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="bootstrap__permissions_resolved" default="f16" /><bpmn:task id="bootstrap__permissions_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="bootstrap__permissions_call" calledElement="assistant.authorization" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="bootstrap__permissions_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;task&quot;: &quot;permissions&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="bootstrap__permissions_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="bootstrap__check" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;task&quot;: &quot;check&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="bootstrap__check_status" default="f23" /><bpmn:task id="bootstrap__check_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="bootstrap__ready" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;gateway&quot;: &quot;ready&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="bootstrap__ready_select" default="f28" /><bpmn:serviceTask id="bootstrap__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="bootstrap__blocked" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;blocked&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__blocked_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="bootstrap__permissions__disposition" default="f37" /><bpmn:serviceTask id="bootstrap__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="bootstrap__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="bootstrap__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="bootstrap__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="bootstrap__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="bootstrap__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;bootstrap&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="bootstrap__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="bootstrap__start" targetRef="bootstrap__transport" name="" /><bpmn:sequenceFlow id="f5" sourceRef="bootstrap__transport" targetRef="bootstrap__transport_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="bootstrap__transport_status" targetRef="bootstrap__transport_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="bootstrap__transport_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="bootstrap__transport_accept" targetRef="bootstrap__present" name="" /><bpmn:sequenceFlow id="f9" sourceRef="bootstrap__present" targetRef="bootstrap__present_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="bootstrap__present_select" targetRef="bootstrap__permissions" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="bootstrap__present_select" targetRef="bootstrap__blocked" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="bootstrap__present_select" targetRef="bootstrap__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="bootstrap__permissions" targetRef="bootstrap__permissions_prepared" name="" /><bpmn:sequenceFlow id="f14" sourceRef="bootstrap__permissions_prepared" targetRef="bootstrap__permissions_resolved" name="" /><bpmn:sequenceFlow id="f15" sourceRef="bootstrap__permissions_resolved" targetRef="bootstrap__permissions_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="bootstrap__permissions_resolved" targetRef="bootstrap__permissions_call" name="" /><bpmn:sequenceFlow id="f17" sourceRef="bootstrap__permissions_resolved_result" targetRef="bootstrap__permissions_merge" name="" /><bpmn:sequenceFlow id="f18" sourceRef="bootstrap__permissions_call" targetRef="bootstrap__permissions_merge" name="" /><bpmn:sequenceFlow id="f19" sourceRef="bootstrap__permissions_merge" targetRef="bootstrap__permissions_mapped" name="" /><bpmn:sequenceFlow id="f20" sourceRef="bootstrap__permissions_mapped" targetRef="bootstrap__permissions__disposition" name="" /><bpmn:sequenceFlow id="f21" sourceRef="bootstrap__check" targetRef="bootstrap__check_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="bootstrap__check_status" targetRef="bootstrap__check_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="bootstrap__check_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="bootstrap__check_accept" targetRef="bootstrap__ready" name="" /><bpmn:sequenceFlow id="f25" sourceRef="bootstrap__ready" targetRef="bootstrap__ready_select" name="" /><bpmn:sequenceFlow id="f26" sourceRef="bootstrap__ready_select" targetRef="bootstrap__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="bootstrap__ready_select" targetRef="bootstrap__blocked" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="bootstrap__ready_select" targetRef="bootstrap__return_unresolved" name="" /><bpmn:sequenceFlow id="f29" sourceRef="bootstrap__end" targetRef="bootstrap__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="bootstrap__blocked" targetRef="bootstrap__blocked_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__check" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="bootstrap__permissions__disposition" targetRef="bootstrap__return_unresolved" name="" /><bpmn:sequenceFlow id="f38" sourceRef="bootstrap__return_rejected" targetRef="bootstrap__return_rejected_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="bootstrap__return_deferred" targetRef="bootstrap__return_deferred_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="bootstrap__return_pending" targetRef="bootstrap__return_pending_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="bootstrap__return_unresolved" targetRef="bootstrap__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="bootstrap__return_faulted" targetRef="bootstrap__return_faulted_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>