<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.verification_systems" name="Post-change system and data checks" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Execute each required check from the reviewed impact inventory.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="verification_systems__start" b:set="{}" /><bpmn:serviceTask id="verification_systems__next" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;gateway&quot;: &quot;next&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="verification_systems__next_select" default="f8" /><bpmn:serviceTask id="verification_systems__check" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;task&quot;: &quot;check&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="verification_systems__check_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="verification_systems__check_resolved" default="f12" /><bpmn:task id="verification_systems__check_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="verification_systems__check_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="verification_systems__check_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;task&quot;: &quot;check&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="verification_systems__check_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="verification_systems__retain" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;task&quot;: &quot;retain&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="verification_systems__retain_status" default="f19" /><bpmn:task id="verification_systems__retain_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="verification_systems__harm" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;gateway&quot;: &quot;harm&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="verification_systems__harm_select" default="f24" /><bpmn:serviceTask id="verification_systems__unsafe" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;unsafe&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__unsafe_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="verification_systems__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="verification_systems__check__disposition" default="f33" /><bpmn:serviceTask id="verification_systems__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="verification_systems__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="verification_systems__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="verification_systems__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="verification_systems__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="verification_systems__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;verification_systems&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="verification_systems__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="verification_systems__start" targetRef="verification_systems__next" name="" /><bpmn:sequenceFlow id="f5" sourceRef="verification_systems__next" targetRef="verification_systems__next_select" name="" /><bpmn:sequenceFlow id="f6" sourceRef="verification_systems__next_select" targetRef="verification_systems__check" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="verification_systems__next_select" targetRef="verification_systems__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f8" sourceRef="verification_systems__next_select" targetRef="verification_systems__return_unresolved" name="" /><bpmn:sequenceFlow id="f9" sourceRef="verification_systems__check" targetRef="verification_systems__check_prepared" name="" /><bpmn:sequenceFlow id="f10" sourceRef="verification_systems__check_prepared" targetRef="verification_systems__check_resolved" name="" /><bpmn:sequenceFlow id="f11" sourceRef="verification_systems__check_resolved" targetRef="verification_systems__check_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="verification_systems__check_resolved" targetRef="verification_systems__check_call" name="" /><bpmn:sequenceFlow id="f13" sourceRef="verification_systems__check_resolved_result" targetRef="verification_systems__check_merge" name="" /><bpmn:sequenceFlow id="f14" sourceRef="verification_systems__check_call" targetRef="verification_systems__check_merge" name="" /><bpmn:sequenceFlow id="f15" sourceRef="verification_systems__check_merge" targetRef="verification_systems__check_mapped" name="" /><bpmn:sequenceFlow id="f16" sourceRef="verification_systems__check_mapped" targetRef="verification_systems__check__disposition" name="" /><bpmn:sequenceFlow id="f17" sourceRef="verification_systems__retain" targetRef="verification_systems__retain_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="verification_systems__retain_status" targetRef="verification_systems__retain_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="verification_systems__retain_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="verification_systems__retain_accept" targetRef="verification_systems__harm" name="" /><bpmn:sequenceFlow id="f21" sourceRef="verification_systems__harm" targetRef="verification_systems__harm_select" name="" /><bpmn:sequenceFlow id="f22" sourceRef="verification_systems__harm_select" targetRef="verification_systems__unsafe" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="verification_systems__harm_select" targetRef="verification_systems__next" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="verification_systems__harm_select" targetRef="verification_systems__return_unresolved" name="" /><bpmn:sequenceFlow id="f25" sourceRef="verification_systems__unsafe" targetRef="verification_systems__unsafe_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="verification_systems__end" targetRef="verification_systems__end_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__retain" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f30" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="verification_systems__check__disposition" targetRef="verification_systems__return_unresolved" name="" /><bpmn:sequenceFlow id="f34" sourceRef="verification_systems__return_rejected" targetRef="verification_systems__return_rejected_end" name="" /><bpmn:sequenceFlow id="f35" sourceRef="verification_systems__return_deferred" targetRef="verification_systems__return_deferred_end" name="" /><bpmn:sequenceFlow id="f36" sourceRef="verification_systems__return_pending" targetRef="verification_systems__return_pending_end" name="" /><bpmn:sequenceFlow id="f37" sourceRef="verification_systems__return_unresolved" targetRef="verification_systems__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="verification_systems__return_faulted" targetRef="verification_systems__return_faulted_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>