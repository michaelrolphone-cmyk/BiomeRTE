<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.dispatch" name="Durable asynchronous reasoning dispatch" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Admit a durable controller reasoning episode asynchronously without making it a cycle child whose completion is awaited.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="dispatch__start" b:set="{}" /><bpmn:serviceTask id="dispatch__intent" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;task&quot;: &quot;intent&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="dispatch__intent_status" default="f7" /><bpmn:task id="dispatch__intent_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="dispatch__guard" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;task&quot;: &quot;guard&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="dispatch__guard_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="dispatch__guard_resolved" default="f12" /><bpmn:task id="dispatch__guard_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="dispatch__guard_call" calledElement="assistant.governed" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="dispatch__guard_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;task&quot;: &quot;guard&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="dispatch__guard_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="dispatch__receipt" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;task&quot;: &quot;receipt&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="dispatch__receipt_status" default="f19" /><bpmn:task id="dispatch__receipt_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="dispatch__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="dispatch__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="dispatch__release" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;task&quot;: &quot;release&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="dispatch__release_status" default="f24" /><bpmn:task id="dispatch__release_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:exclusiveGateway id="dispatch__guard__disposition" default="f32" /><bpmn:serviceTask id="dispatch__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="dispatch__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="dispatch__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="dispatch__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="dispatch__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="dispatch__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="dispatch__aborted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;terminal&quot;: &quot;aborted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="dispatch__aborted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;dispatch&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="dispatch__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="dispatch__start" targetRef="dispatch__intent" name="" /><bpmn:sequenceFlow id="f5" sourceRef="dispatch__intent" targetRef="dispatch__intent_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="dispatch__intent_status" targetRef="dispatch__intent_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="dispatch__intent_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="dispatch__intent_accept" targetRef="dispatch__guard" name="" /><bpmn:sequenceFlow id="f9" sourceRef="dispatch__guard" targetRef="dispatch__guard_prepared" name="" /><bpmn:sequenceFlow id="f10" sourceRef="dispatch__guard_prepared" targetRef="dispatch__guard_resolved" name="" /><bpmn:sequenceFlow id="f11" sourceRef="dispatch__guard_resolved" targetRef="dispatch__guard_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="dispatch__guard_resolved" targetRef="dispatch__guard_call" name="" /><bpmn:sequenceFlow id="f13" sourceRef="dispatch__guard_resolved_result" targetRef="dispatch__guard_merge" name="" /><bpmn:sequenceFlow id="f14" sourceRef="dispatch__guard_call" targetRef="dispatch__guard_merge" name="" /><bpmn:sequenceFlow id="f15" sourceRef="dispatch__guard_merge" targetRef="dispatch__guard_mapped" name="" /><bpmn:sequenceFlow id="f16" sourceRef="dispatch__guard_mapped" targetRef="dispatch__guard__disposition" name="" /><bpmn:sequenceFlow id="f17" sourceRef="dispatch__receipt" targetRef="dispatch__receipt_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="dispatch__receipt_status" targetRef="dispatch__receipt_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="dispatch__receipt_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="dispatch__receipt_accept" targetRef="dispatch__end" name="" /><bpmn:sequenceFlow id="f21" sourceRef="dispatch__end" targetRef="dispatch__end_end" name="" /><bpmn:sequenceFlow id="f22" sourceRef="dispatch__release" targetRef="dispatch__release_status" name="" /><bpmn:sequenceFlow id="f23" sourceRef="dispatch__release_status" targetRef="dispatch__release_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="dispatch__release_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f25" sourceRef="dispatch__release_accept" targetRef="dispatch__aborted" name="" /><bpmn:sequenceFlow id="f26" sourceRef="dispatch__guard__disposition" targetRef="dispatch__receipt" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="dispatch__guard__disposition" targetRef="dispatch__release" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="dispatch__guard__disposition" targetRef="dispatch__release" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="dispatch__guard__disposition" targetRef="dispatch__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f30" sourceRef="dispatch__guard__disposition" targetRef="dispatch__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="dispatch__guard__disposition" targetRef="dispatch__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="dispatch__guard__disposition" targetRef="dispatch__return_unresolved" name="" /><bpmn:sequenceFlow id="f33" sourceRef="dispatch__return_pending" targetRef="dispatch__return_pending_end" name="" /><bpmn:sequenceFlow id="f34" sourceRef="dispatch__return_unresolved" targetRef="dispatch__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f35" sourceRef="dispatch__return_faulted" targetRef="dispatch__return_faulted_end" name="" /><bpmn:sequenceFlow id="f36" sourceRef="dispatch__aborted" targetRef="dispatch__aborted_end" name="" /><bpmn:sequenceFlow id="f37" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>