<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.containment" name="Standing-authority containment" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Respond promptly to harm using only previously authorized bounded containment actions.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;containment&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="containment__start" b:set="{}" /><bpmn:serviceTask id="containment__match" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;containment&quot;, &quot;task&quot;: &quot;match&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="containment__match_status" default="f7" /><bpmn:task id="containment__match_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="containment__allowed" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;containment&quot;, &quot;gateway&quot;: &quot;allowed&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="containment__allowed_select" default="f12" /><bpmn:serviceTask id="contain