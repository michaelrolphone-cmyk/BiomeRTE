<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.provider_dispatch" name="Interchangeable capability dispatch" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Dispatch one already-authorized operation through a compatible Biome provider; no permanent agent worker pool.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="provider_dispatch__start" b:set="{}" /><bpmn:serviceTask id="provider_dispatch__validate" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;task&quot;: &quot;validate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__validate_status" default="f7" /><bpmn:task id="provider_dispatch__validate_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="provider_dispatch__valid" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;gateway&quot;: &quot;valid&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__valid_select" default="f12" /><bpmn:serviceTask id="provider_dispatch__select" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;task&quot;: &quot;select&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__select_status" default="f15" /><bpmn:task id="provider_dispatch__select_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="provider_dispatch__capacity" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;gateway&quot;: &quot;capacity&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__capacity_select" default="f20" /><bpmn:serviceTask id="provider_dispatch__dispatch" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;task&quot;: &quot;dispatch&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__dispatch_status" default="f23" /><bpmn:task id="provider_dispatch__dispatch_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="provider_dispatch__receipt" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;gateway&quot;: &quot;receipt&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__receipt_select" default="f29" /><bpmn:serviceTask id="provider_dispatch__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="provider_dispatch__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="provider_dispatch__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="provider_dispatch__pending_status" default="f33" /><bpmn:task id="provider_dispatch__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="provider_dispatch__unknown" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;terminal&quot;: &quot;unknown&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="provider_dispatch__unknown_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="provider_dispatch__rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;terminal&quot;: &quot;rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="provider_dispatch__rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="provider_dispatch__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="provider_dispatch__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;provider_dispatch&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="provider_dispatch__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="provider_dispatch__start" targetRef="provider_dispatch__validate" name="" /><bpmn:sequenceFlow id="f5" sourceRef="provider_dispatch__validate" targetRef="provider_dispatch__validate_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="provider_dispatch__validate_status" targetRef="provider_dispatch__validate_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="provider_dispatch__validate_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="provider_dispatch__validate_accept" targetRef="provider_dispatch__valid" name="" /><bpmn:sequenceFlow id="f9" sourceRef="provider_dispatch__valid" targetRef="provider_dispatch__valid_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="provider_dispatch__valid_select" targetRef="provider_dispatch__select" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="provider_dispatch__valid_select" targetRef="provider_dispatch__rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="provider_dispatch__valid_select" targetRef="provider_dispatch__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="provider_dispatch__select" targetRef="provider_dispatch__select_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="provider_dispatch__select_status" targetRef="provider_dispatch__select_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="provider_dispatch__select_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="provider_dispatch__select_accept" targetRef="provider_dispatch__capacity" name="" /><bpmn:sequenceFlow id="f17" sourceRef="provider_dispatch__capacity" targetRef="provider_dispatch__capacity_select" name="" /><bpmn:sequenceFlow id="f18" sourceRef="provider_dispatch__capacity_select" targetRef="provider_dispatch__dispatch" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="provider_dispatch__capacity_select" targetRef="provider_dispatch__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="provider_dispatch__capacity_select" targetRef="provider_dispatch__return_unresolved" name="" /><bpmn:sequenceFlow id="f21" sourceRef="provider_dispatch__dispatch" targetRef="provider_dispatch__dispatch_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="provider_dispatch__dispatch_status" targetRef="provider_dispatch__dispatch_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="provider_dispatch__dispatch_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="provider_dispatch__dispatch_accept" targetRef="provider_dispatch__receipt" name="" /><bpmn:sequenceFlow id="f25" sourceRef="provider_dispatch__receipt" targetRef="provider_dispatch__receipt_select" name="" /><bpmn:sequenceFlow id="f26" sourceRef="provider_dispatch__receipt_select" targetRef="provider_dispatch__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="provider_dispatch__receipt_select" targetRef="provider_dispatch__unknown" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="provider_dispatch__receipt_select" targetRef="provider_dispatch__rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="provider_dispatch__receipt_select" targetRef="provider_dispatch__return_unresolved" name="" /><bpmn:sequenceFlow id="f30" sourceRef="provider_dispatch__end" targetRef="provider_dispatch__end_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="provider_dispatch__pending" targetRef="provider_dispatch__pending_status" name="" /><bpmn:sequenceFlow id="f32" sourceRef="provider_dispatch__pending_status" targetRef="provider_dispatch__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="provider_dispatch__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f34" sourceRef="provider_dispatch__pending_resume" targetRef="provider_dispatch__select" name="" /><bpmn:sequenceFlow id="f35" sourceRef="provider_dispatch__unknown" targetRef="provider_dispatch__unknown_end" name="" /><bpmn:sequenceFlow id="f36" sourceRef="provider_dispatch__rejected" targetRef="provider_dispatch__rejected_end" name="" /><bpmn:sequenceFlow id="f37" sourceRef="provider_dispatch__return_unresolved" targetRef="provider_dispatch__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>