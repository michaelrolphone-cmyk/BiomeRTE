ect" default="f28" /><bpmn:serviceTask id="checkpoint__read" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;checkpoint&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="checkpoint__read_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="checkpoint__read_resolved" default="f32" /><bpmn:task id="checkpoint__read_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="checkpoint__read_call" calledElement="assistant.access" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="checkpoint__read_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;checkpoint&quot;, &quot;task&quot;: &quot;read&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="checkpoint__read_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="checkpoint__merge" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;checkpoint&quot;, &quot;gateway&quot;: &quot;merge&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="checkpoint__merge_select" default="f40" /><bpmn:serviceTask id="checkpoint__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;checkpoint&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="checkpoint__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="checkpoint__conflict" b:ope