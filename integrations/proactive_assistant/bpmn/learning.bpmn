<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.learning" name="Learning from all outcomes" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Retain supported lessons, failures and counterexamples; separately govern procedure changes.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="learning__start" b:set="{}" /><bpmn:serviceTask id="learning__compare" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;compare&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="learning__compare_status" default="f7" /><bpmn:task id="learning__compare_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="learning__generalize" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;generalize&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="learning__generalize_status" default="f11" /><bpmn:task id="learning__generalize_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="learning__challenge" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;challenge&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="learning__challenge_status" default="f15" /><bpmn:task id="learning__challenge_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="learning__commit" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;commit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="learning__commit_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="learning__commit_resolved" default="f20" /><bpmn:task id="learning__commit_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="learning__commit_call" calledElement="assistant.checkpoint" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="learning__commit_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;commit&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="learning__commit_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="learning__change" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;gateway&quot;: &quot;change&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="learning__change_select" default="f28" /><bpmn:serviceTask id="learning__manage" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;manage&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="learning__manage_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="learning__manage_resolved" default="f32" /><bpmn:task id="learning__manage_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="learning__manage_call" calledElement="assistant.change_management" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="learning__manage_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;task&quot;: &quot;manage&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="learning__manage_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="learning__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="learning__commit__disposition" default="f44" /><bpmn:serviceTask id="learning__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="learning__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="learning__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="learning__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="learning__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="learning__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="learning__manage__disposition" default="f56" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;learning&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="learning__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="learning__start" targetRef="learning__compare" name="" /><bpmn:sequenceFlow id="f5" sourceRef="learning__compare" targetRef="learning__compare_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="learning__compare_status" targetRef="learning__compare_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="learning__compare_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="learning__compare_accept" targetRef="learning__generalize" name="" /><bpmn:sequenceFlow id="f9" sourceRef="learning__generalize" targetRef="learning__generalize_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="learning__generalize_status" targetRef="learning__generalize_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="learning__generalize_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="learning__generalize_accept" targetRef="learning__challenge" name="" /><bpmn:sequenceFlow id="f13" sourceRef="learning__challenge" targetRef="learning__challenge_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="learning__challenge_status" targetRef="learning__challenge_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="learning__challenge_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="learning__challenge_accept" targetRef="learning__commit" name="" /><bpmn:sequenceFlow id="f17" sourceRef="learning__commit" targetRef="learning__commit_prepared" name="" /><bpmn:sequenceFlow id="f18" sourceRef="learning__commit_prepared" targetRef="learning__commit_resolved" name="" /><bpmn:sequenceFlow id="f19" sourceRef="learning__commit_resolved" targetRef="learning__commit_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="learning__commit_resolved" targetRef="learning__commit_call" name="" /><bpmn:sequenceFlow id="f21" sourceRef="learning__commit_resolved_result" targetRef="learning__commit_merge" name="" /><bpmn:sequenceFlow id="f22" sourceRef="learning__commit_call" targetRef="learning__commit_merge" name="" /><bpmn:sequenceFlow id="f23" sourceRef="learning__commit_merge" targetRef="learning__commit_mapped" name="" /><bpmn:sequenceFlow id="f24" sourceRef="learning__commit_mapped" targetRef="learning__commit__disposition" name="" /><bpmn:sequenceFlow id="f25" sourceRef="learning__change" targetRef="learning__change_select" name="" /><bpmn:sequenceFlow id="f26" sourceRef="learning__change_select" targetRef="learning__manage" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="learning__change_select" targetRef="learning__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="learning__change_select" targetRef="learning__return_unresolved" name="" /><bpmn:sequenceFlow id="f29" sourceRef="learning__manage" targetRef="learning__manage_prepared" name="" /><bpmn:sequenceFlow id="f30" sourceRef="learning__manage_prepared" targetRef="learning__manage_resolved" name="" /><bpmn:sequenceFlow id="f31" sourceRef="learning__manage_resolved" targetRef="learning__manage_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="learning__manage_resolved" targetRef="learning__manage_call" name="" /><bpmn:sequenceFlow id="f33" sourceRef="learning__manage_resolved_result" targetRef="learning__manage_merge" name="" /><bpmn:sequenceFlow id="f34" sourceRef="learning__manage_call" targetRef="learning__manage_merge" name="" /><bpmn:sequenceFlow id="f35" sourceRef="learning__manage_merge" targetRef="learning__manage_mapped" name="" /><bpmn:sequenceFlow id="f36" sourceRef="learning__manage_mapped" targetRef="learning__manage__disposition" name="" /><bpmn:sequenceFlow id="f37" sourceRef="learning__end" targetRef="learning__end_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="learning__commit__disposition" targetRef="learning__change" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f39" sourceRef="learning__commit__disposition" targetRef="learning__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f40" sourceRef="learning__commit__disposition" targetRef="learning__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f41" sourceRef="learning__commit__disposition" targetRef="learning__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f42" sourceRef="learning__commit__disposition" targetRef="learning__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f43" sourceRef="learning__commit__disposition" targetRef="learning__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f44" sourceRef="learning__commit__disposition" targetRef="learning__return_unresolved" name="" /><bpmn:sequenceFlow id="f45" sourceRef="learning__return_rejected" targetRef="learning__return_rejected_end" name="" /><bpmn:sequenceFlow id="f46" sourceRef="learning__return_deferred" targetRef="learning__return_deferred_end" name="" /><bpmn:sequenceFlow id="f47" sourceRef="learning__return_pending" targetRef="learning__return_pending_end" name="" /><bpmn:sequenceFlow id="f48" sourceRef="learning__return_unresolved" targetRef="learning__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f49" sourceRef="learning__return_faulted" targetRef="learning__return_faulted_end" name="" /><bpmn:sequenceFlow id="f50" sourceRef="learning__manage__disposition" targetRef="learning__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f51" sourceRef="learning__manage__disposition" targetRef="learning__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f52" sourceRef="learning__manage__disposition" targetRef="learning__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f53" sourceRef="learning__manage__disposition" targetRef="learning__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f54" sourceRef="learning__manage__disposition" targetRef="learning__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f55" sourceRef="learning__manage__disposition" targetRef="learning__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f56" sourceRef="learning__manage__disposition" targetRef="learning__return_unresolved" name="" /><bpmn:sequenceFlow id="f57" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f58" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>