<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.control" name="Standing responsibility control" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Change durable desired state and issue correlated triggers without directly starting competing cycles.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="control__start" b:set="{}" /><bpmn:serviceTask id="control__validate" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;validate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="control__validate_status" default="f7" /><bpmn:task id="control__validate_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="control__valid" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;gateway&quot;: &quot;valid&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="control__valid_select" default="f12" /><bpmn:serviceTask id="control__kind" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;gateway&quot;: &quot;kind&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="control__kind_select" default="f18" /><bpmn:serviceTask id="control__state" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;state&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="control__state_status" default="f21" /><bpmn:task id="control__state_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="control__cancel" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;cancel&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="control__cancel_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="control__cancel_resolved" default="f26" /><bpmn:task id="control__cancel_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="control__cancel_call" calledElement="assistant.governed" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="control__cancel_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;cancel&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="control__cancel_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="control__adopt" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;adopt&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="control__adopt_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="control__adopt_resolved" default="f34" /><bpmn:task id="control__adopt_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="control__adopt_call" calledElement="assistant.revision_adoption" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="control__adopt_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;adopt&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="control__adopt_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="control__contain" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;control&quot;, &quot;task&quot;: &quot;contain&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="control__contain_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="control__contain_resolved" default="f42" /><bpmn:task id="control__contain_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="control__contain_call" calledElement="assistant.containment" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="control__contain_merge" b