<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.git_publish" name="Publish reviewed source before disposal" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Require exact passing tests and final review; verify source still matches, commit and publish a dedicated branch, then verify the remote commit.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="git_publish__start" b:set="{}" /><bpmn:serviceTask id="git_publish__acquire" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;acquire&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__acquire_status" default="f7" /><bpmn:task id="git_publish__acquire_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__commit" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;commit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__commit_status" default="f11" /><bpmn:task id="git_publish__commit_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__push" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;push&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__push_status" default="f15" /><bpmn:task id="git_publish__push_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__verify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;verify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__verify_status" default="f19" /><bpmn:task id="git_publish__verify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__catalog" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;catalog&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__catalog_status" default="f23" /><bpmn:task id="git_publish__catalog_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__review_request" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;task&quot;: &quot;review_request&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="git_publish__review_request_status" default="f27" /><bpmn:task id="git_publish__review_request_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="git_publish__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="git_publish__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;git_publish&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="git_publish__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="git_publish__start" targetRef="git_publish__acquire" name="" /><bpmn:sequenceFlow id="f5" sourceRef="git_publish__acquire" targetRef="git_publish__acquire_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="git_publish__acquire_status" targetRef="git_publish__acquire_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="git_publish__acquire_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="git_publish__acquire_accept" targetRef="git_publish__commit" name="" /><bpmn:sequenceFlow id="f9" sourceRef="git_publish__commit" targetRef="git_publish__commit_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="git_publish__commit_status" targetRef="git_publish__commit_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="git_publish__commit_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="git_publish__commit_accept" targetRef="git_publish__push" name="" /><bpmn:sequenceFlow id="f13" sourceRef="git_publish__push" targetRef="git_publish__push_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="git_publish__push_status" targetRef="git_publish__push_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="git_publish__push_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="git_publish__push_accept" targetRef="git_publish__verify" name="" /><bpmn:sequenceFlow id="f17" sourceRef="git_publish__verify" targetRef="git_publish__verify_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="git_publish__verify_status" targetRef="git_publish__verify_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="git_publish__verify_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="git_publish__verify_accept" targetRef="git_publish__catalog" name="" /><bpmn:sequenceFlow id="f21" sourceRef="git_publish__catalog" targetRef="git_publish__catalog_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="git_publish__catalog_status" targetRef="git_publish__catalog_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="git_publish__catalog_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="git_publish__catalog_accept" targetRef="git_publish__review_request" name="" /><bpmn:sequenceFlow id="f25" sourceRef="git_publish__review_request" targetRef="git_publish__review_request_status" name="" /><bpmn:sequenceFlow id="f26" sourceRef="git_publish__review_request_status" targetRef="git_publish__review_request_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="git_publish__review_request_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f28" sourceRef="git_publish__review_request_accept" targetRef="git_publish__end" name="" /><bpmn:sequenceFlow id="f29" sourceRef="git_publish__end" targetRef="git_publish__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>