<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.inventory" name="System and dependency inventory" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Build a versioned impact inventory without assuming discovery is harmless.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="inventory__start" b:set="{}" /><bpmn:serviceTask id="inventory__discover" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;discover&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="inventory__discover_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="inventory__discover_resolved" default="f8" /><bpmn:task id="inventory__discover_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="inventory__discover_call" calledElement="assistant.access" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="inventory__discover_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;discover&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="inventory__discover_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="inventory__relate" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;relate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="inventory__relate_status" default="f15" /><bpmn:task id="inventory__relate_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="inventory__unknown" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;unknown&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="inventory__unknown_status" default="f19" /><bpmn:task id="inventory__unknown_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="inventory__commit" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;commit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="inventory__commit_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="inventory__commit_resolved" default="f24" /><bpmn:task id="inventory__commit_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="inventory__commit_call" calledElement="assistant.checkpoint" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="inventory__commit_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;task&quot;: &quot;commit&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="inventory__commit_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="inventory__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="inventory__discover__disposition" default="f36" /><bpmn:serviceTask id="inventory__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="inventory__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="inventory__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="inventory__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="inventory__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="inventory__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="inventory__commit__disposition" default="f48" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;inventory&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="inventory__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="inventory__start" targetRef="inventory__discover" name="" /><bpmn:sequenceFlow id="f5" sourceRef="inventory__discover" targetRef="inventory__discover_prepared" name="" /><bpmn:sequenceFlow id="f6" sourceRef="inventory__discover_prepared" targetRef="inventory__discover_resolved" name="" /><bpmn:sequenceFlow id="f7" sourceRef="inventory__discover_resolved" targetRef="inventory__discover_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f8" sourceRef="inventory__discover_resolved" targetRef="inventory__discover_call" name="" /><bpmn:sequenceFlow id="f9" sourceRef="inventory__discover_resolved_result" targetRef="inventory__discover_merge" name="" /><bpmn:sequenceFlow id="f10" sourceRef="inventory__discover_call" targetRef="inventory__discover_merge" name="" /><bpmn:sequenceFlow id="f11" sourceRef="inventory__discover_merge" targetRef="inventory__discover_mapped" name="" /><bpmn:sequenceFlow id="f12" sourceRef="inventory__discover_mapped" targetRef="inventory__discover__disposition" name="" /><bpmn:sequenceFlow id="f13" sourceRef="inventory__relate" targetRef="inventory__relate_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="inventory__relate_status" targetRef="inventory__relate_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="inventory__relate_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="inventory__relate_accept" targetRef="inventory__unknown" name="" /><bpmn:sequenceFlow id="f17" sourceRef="inventory__unknown" targetRef="inventory__unknown_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="inventory__unknown_status" targetRef="inventory__unknown_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="inventory__unknown_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="inventory__unknown_accept" targetRef="inventory__commit" name="" /><bpmn:sequenceFlow id="f21" sourceRef="inventory__commit" targetRef="inventory__commit_prepared" name="" /><bpmn:sequenceFlow id="f22" sourceRef="inventory__commit_prepared" targetRef="inventory__commit_resolved" name="" /><bpmn:sequenceFlow id="f23" sourceRef="inventory__commit_resolved" targetRef="inventory__commit_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="inventory__commit_resolved" targetRef="inventory__commit_call" name="" /><bpmn:sequenceFlow id="f25" sourceRef="inventory__commit_resolved_result" targetRef="inventory__commit_merge" name="" /><bpmn:sequenceFlow id="f26" sourceRef="inventory__commit_call" targetRef="inventory__commit_merge" name="" /><bpmn:sequenceFlow id="f27" sourceRef="inventory__commit_merge" targetRef="inventory__commit_mapped" name="" /><bpmn:sequenceFlow id="f28" sourceRef="inventory__commit_mapped" targetRef="inventory__commit__disposition" name="" /><bpmn:sequenceFlow id="f29" sourceRef="inventory__end" targetRef="inventory__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="inventory__discover__disposition" targetRef="inventory__relate" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="inventory__discover__disposition" targetRef="inventory__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="inventory__discover__disposition" targetRef="inventory__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="inventory__discover__disposition" targetRef="inventory__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="inventory__discover__disposition" targetRef="inventory__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="inventory__discover__disposition" targetRef="inventory__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="inventory__discover__disposition" targetRef="inventory__return_unresolved" name="" /><bpmn:sequenceFlow id="f37" sourceRef="inventory__return_rejected" targetRef="inventory__return_rejected_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="inventory__return_deferred" targetRef="inventory__return_deferred_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="inventory__return_pending" targetRef="inventory__return_pending_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="inventory__return_unresolved" targetRef="inventory__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="inventory__return_faulted" targetRef="inventory__return_faulted_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="inventory__commit__disposition" targetRef="inventory__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f43" sourceRef="inventory__commit__disposition" targetRef="inventory__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f44" sourceRef="inventory__commit__disposition" targetRef="inventory__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f45" sourceRef="inventory__commit__disposition" targetRef="inventory__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f46" sourceRef="inventory__commit__disposition" targetRef="inventory__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f47" sourceRef="inventory__commit__disposition" targetRef="inventory__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f48" sourceRef="inventory__commit__disposition" targetRef="inventory__return_unresolved" name="" /><bpmn:sequenceFlow id="f49" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f50" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>