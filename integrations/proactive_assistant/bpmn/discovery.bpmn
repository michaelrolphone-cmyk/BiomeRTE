<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.discovery" name="Due observation and candidate discovery" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Inspect only due signals and turn observations into deduplicated candidates.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="discovery__start" b:set="{}" /><bpmn:serviceTask id="discovery__read" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="discovery__read_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="discovery__read_resolved" default="f8" /><bpmn:task id="discovery__read_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="discovery__read_call" calledElement="assistant.access" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="discovery__read_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;read&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="discovery__read_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="discovery__probe" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;gateway&quot;: &quot;probe&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="discovery__probe_select" default="f16" /><bpmn:serviceTask id="discovery__govern" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;govern&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="discovery__govern_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="discovery__govern_resolved" default="f20" /><bpmn:task id="discovery__govern_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="discovery__govern_call" calledElement="assistant.governed" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="discovery__govern_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;govern&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="discovery__govern_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="discovery__classify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;classify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="discovery__classify_status" default="f27" /><bpmn:task id="discovery__classify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="discovery__dedup" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;dedup&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="discovery__dedup_status" default="f31" /><bpmn:task id="discovery__dedup_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="discovery__candidate" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;candidate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="discovery__candidate_status" default="f35" /><bpmn:task id="discovery__candidate_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="discovery__save" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;discovery&quot;, &quot;task&quot;: &quot;save&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="discovery__save_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="discovery__save_resolved" default="f40" /><bpmn:task id="discovery__save_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="discovery__save_call" calledElement="assistant.checkpoint" b:args="{&q