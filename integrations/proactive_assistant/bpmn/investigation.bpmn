<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.investigation" name="Scoped investigation planning" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Resolve missing information without recursive governance calls in the same stack.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="investigation__start" b:set="{}" /><bpmn:serviceTask id="investigation__scope" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;task&quot;: &quot;scope&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="investigation__scope_status" default="f7" /><bpmn:task id="investigation__scope_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="investigation__separable" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;gateway&quot;: &quot;separable&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="investigation__separable_select" default="f12" /><bpmn:serviceTask id="investigation__execute" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;task&quot;: &quot;execute&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="investigation__execute_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="investigation__execute_resolved" default="f16" /><bpmn:task id="investigation__execute_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="investigation__execute_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="investigation__execute_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;task&quot;: &quot;execute&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="investigation__execute_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="investigation__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="investigation__child" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;task&quot;: &quot;child&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="investigation__child_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="investigation__child_resolved" default="f25" /><bpmn:task id="investigation__child_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="investigation__child_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="investigation__child_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;task&quot;: &quot;child&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="investigation__child_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="investigation__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="investigation__pending_status" default="f32" /><bpmn:task id="investigation__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:exclusiveGateway id="investigation__execute__disposition" default="f40" /><bpmn:serviceTask id="investigation__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="investigation__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="investigation__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="investigation__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="investigation__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="investigation__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="investigation__child__disposition" default="f52" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;investigation&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="investigation__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="investigation__start" targetRef="investigation__scope" name="" /><bpmn:sequenceFlow id="f5" sourceRef="investigation__scope" targetRef="investigation__scope_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="investigation__scope_status" targetRef="investigation__scope_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="investigation__scope_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="investigation__scope_accept" targetRef="investigation__separable" name="" /><bpmn:sequenceFlow id="f9" sourceRef="investigation__separable" targetRef="investigation__separable_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="investigation__separable_select" targetRef="investigation__execute" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="investigation__separable_select" targetRef="investigation__child" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="investigation__separable_select" targetRef="investigation__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="investigation__execute" targetRef="investigation__execute_prepared" name="" /><bpmn:sequenceFlow id="f14" sourceRef="investigation__execute_prepared" targetRef="investigation__execute_resolved" name="" /><bpmn:sequenceFlow id="f15" sourceRef="investigation__execute_resolved" targetRef="investigation__execute_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="investigation__execute_resolved" targetRef="investigation__execute_call" name="" /><bpmn:sequenceFlow id="f17" sourceRef="investigation__execute_resolved_result" targetRef="investigation__execute_merge" name="" /><bpmn:sequenceFlow id="f18" sourceRef="investigation__execute_call" targetRef="investigation__execute_merge" name="" /><bpmn:sequenceFlow id="f19" sourceRef="investigation__execute_merge" targetRef="investigation__execute_mapped" name="" /><bpmn:sequenceFlow id="f20" sourceRef="investigation__execute_mapped" targetRef="investigation__execute__disposition" name="" /><bpmn:sequenceFlow id="f21" sourceRef="investigation__end" targetRef="investigation__end_end" name="" /><bpmn:sequenceFlow id="f22" sourceRef="investigation__child" targetRef="investigation__child_prepared" name="" /><bpmn:sequenceFlow id="f23" sourceRef="investigation__child_prepared" targetRef="investigation__child_resolved" name="" /><bpmn:sequenceFlow id="f24" sourceRef="investigation__child_resolved" targetRef="investigation__child_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f25" sourceRef="investigation__child_resolved" targetRef="investigation__child_call" name="" /><bpmn:sequenceFlow id="f26" sourceRef="investigation__child_resolved_result" targetRef="investigation__child_merge" name="" /><bpmn:sequenceFlow id="f27" sourceRef="investigation__child_call" targetRef="investigation__child_merge" name="" /><bpmn:sequenceFlow id="f28" sourceRef="investigation__child_merge" targetRef="investigation__child_mapped" name="" /><bpmn:sequenceFlow id="f29" sourceRef="investigation__child_mapped" targetRef="investigation__child__disposition" name="" /><bpmn:sequenceFlow id="f30" sourceRef="investigation__pending" targetRef="investigation__pending_status" name="" /><bpmn:sequenceFlow id="f31" sourceRef="investigation__pending_status" targetRef="investigation__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="investigation__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f33" sourceRef="investigation__pending_resume" targetRef="investigation__scope" name="" /><bpmn:sequenceFlow id="f34" sourceRef="investigation__execute__disposition" targetRef="investigation__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="investigation__execute__disposition" targetRef="investigation__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="investigation__execute__disposition" targetRef="investigation__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="investigation__execute__disposition" targetRef="investigation__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="investigation__execute__disposition" targetRef="investigation__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f39" sourceRef="investigation__execute__disposition" targetRef="investigation__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f40" sourceRef="investigation__execute__disposition" targetRef="investigation__return_unresolved" name="" /><bpmn:sequenceFlow id="f41" sourceRef="investigation__return_rejected" targetRef="investigation__return_rejected_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="investigation__return_deferred" targetRef="investigation__return_deferred_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="investigation__return_pending" targetRef="investigation__return_pending_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="investigation__return_unresolved" targetRef="investigation__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="investigation__return_faulted" targetRef="investigation__return_faulted_end" name="" /><bpmn:sequenceFlow id="f46" sourceRef="investigation__child__disposition" targetRef="investigation__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f47" sourceRef="investigation__child__disposition" targetRef="investigation__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f48" sourceRef="investigation__child__disposition" targetRef="investigation__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f49" sourceRef="investigation__child__disposition" targetRef="investigation__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f50" sourceRef="investigation__child__disposition" targetRef="investigation__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f51" sourceRef="investigation__child__disposition" targetRef="investigation__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f52" sourceRef="investigation__child__disposition" targetRef="investigation__return_unresolved" name="" /><bpmn:sequenceFlow id="f53" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f54" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>