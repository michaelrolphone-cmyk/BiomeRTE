ot;prepared.result&quot;}}" /><bpmn:callActivity id="qualification__independent_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="qualification__independent_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;task&quot;: &quot;independent&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="qualification__independent_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="qualification__ready" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;gateway&quot;: &quot;ready&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="qualification__ready_select" default="f32" /><bpmn:serviceTask id="qualification__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="qualification__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="qualification__blocked" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;terminal&quot;: &quot;blocked&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="qualification__blocked_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="qualification__policy_valid" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;gateway&quot;: &quot;policy_valid&qu