n"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f63" sourceRef="qualification__independent__disposition" targetRef="qualification__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f64" sourceRef="qualification__independent__disposition" targetRef="qualification__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f65" sourceRef="qualification__independent__disposition" targetRef="qualification__return_unresolved" name="" /><bpmn:sequenceFlow id="f66" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f67" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>