rn_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="qualification__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="qualification__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="qualification__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="qualification__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="qualification__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="qualification__independent__disposition" default="f65" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;qualification&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="qualification__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="qualification__start" targetRef="qualification__policy" name="" /><bpmn:sequenceFlow id="f5" sourceRef="qualification__policy" targetRef="qualification__policy_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="qualification__policy_status" targetRef="qualification__policy_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="qualification__policy_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="qualification__policy_accept" targetRef="qualification__policy_valid" name="" /><bpmn:sequenceFlow id="f9" sourceRef="qualification__contracts" targetRef="qualification__contracts_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="qualification__contracts_status" targetRef="qualification__contracts_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="qualification__contracts_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="qualification__contracts_accept" targetRef="qualification__contracts_valid" name="" /><bpmn:sequenceFlow id="f13" sourceRef="qualification__tests" targetRef="qualification__tests_prepared" name="" /><bpmn:sequenceFlow id="f14" sourceRef="qualification__tests_prepared" targetRef="qualification__tests_resolved" name="" /><bpmn:sequenceFlow id="f15" sourceRef="qualification__tests_resolved" targetRef="qualification__tests_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="qualification__tests_resolved" targetRef="qualification__tests_call" name="" /><bpmn:sequenceFlow id="f17" sourceRef="qualification__tests_resolved_result" targetRef="qualification__tests_merge" name="" /><bpmn:sequenceFlow id="f