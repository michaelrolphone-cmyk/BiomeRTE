<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.judgment" name="Human judgment and clarification" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Ask a question without treating advice or a response as execution permission.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="judgment__start" b:set="{}" /><bpmn:serviceTask id="judgment__question" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;task&quot;: &quot;question&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="judgment__question_status" default="f7" /><bpmn:task id="judgment__question_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="judgment__submit" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;task&quot;: &quot;submit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="judgment__submit_status" default="f11" /><bpmn:task id="judgment__submit_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="judgment__response" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;gateway&quot;: &quot;response&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="judgment__response_select" default="f17" /><bpmn:serviceTask id="judgment__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="judgment__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="judgment__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="judgment__pending_status" default="f21" /><bpmn:task id="judgment__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="judgment__defer" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;terminal&quot;: &quot;defer&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="judgment__defer_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="judgment__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="judgment__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;judgment&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="judgment__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="judgment__start" targetRef="judgment__question" name="" /><bpmn:sequenceFlow id="f5" sourceRef="judgment__question" targetRef="judgment__question_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="judgment__question_status" targetRef="judgment__question_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="judgment__question_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="judgment__question_accept" targetRef="judgment__submit" name="" /><bpmn:sequenceFlow id="f9" sourceRef="judgment__submit" targetRef="judgment__submit_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="judgment__submit_status" targetRef="judgment__submit_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="judgment__submit_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="judgment__submit_accept" targetRef="judgment__response" name="" /><bpmn:sequenceFlow id="f13" sourceRef="judgment__response" targetRef="judgment__response_select" name="" /><bpmn:sequenceFlow id="f14" sourceRef="judgment__response_select" targetRef="judgment__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="judgment__response_select" targetRef="judgment__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="judgment__response_select" targetRef="judgment__defer" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="judgment__response_select" targetRef="judgment__return_unresolved" name="" /><bpmn:sequenceFlow id="f18" sourceRef="judgment__end" targetRef="judgment__end_end" name="" /><bpmn:sequenceFlow id="f19" sourceRef="judgment__pending" targetRef="judgment__pending_status" name="" /><bpmn:sequenceFlow id="f20" sourceRef="judgment__pending_status" targetRef="judgment__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="judgment__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f22" sourceRef="judgment__pending_resume" targetRef="judgment__submit" name="" /><bpmn:sequenceFlow id="f23" sourceRef="judgment__defer" targetRef="judgment__defer_end" name="" /><bpmn:sequenceFlow id="f24" sourceRef="judgment__return_unresolved" targetRef="judgment__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>