<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.watchdog" name="External controller availability watchdog" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Detect loss of the controller failure domain without relying on its workflow engine.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="watchdog__start" b:set="{}" /><bpmn:serviceTask id="watchdog__read" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="watchdog__read_status" default="f7" /><bpmn:task id="watchdog__read_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="watchdog__state" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;gateway&quot;: &quot;state&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="watchdog__state_select" default="f13" /><bpmn:serviceTask id="watchdog__restore" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;task&quot;: &quot;restore&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="watchdog__restore_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="watchdog__restore_resolved" default="f17" /><bpmn:task id="watchdog__restore_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="watchdog__restore_call" calledElement="assistant.external_recovery" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="watchdog__restore_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;task&quot;: &quot;restore&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="watchdog__restore_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="watchdog__handoff" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;task&quot;: &quot;handoff&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="watchdog__handoff_status" default="f24" /><bpmn:task id="watchdog__handoff_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="watchdog__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="watchdog__pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="watchdog__restore_disposition" default="f34" /><bpmn:serviceTask id="watchdog__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="watchdog__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="watchdog__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="watchdog__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="watchdog__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="watchdog__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;watchdog&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="watchdog__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="watchdog__start" targetRef="watchdog__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="watchdog__read" targetRef="watchdog__read_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="watchdog__read_status" targetRef="watchdog__read_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="watchdog__read_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="watchdog__read_accept" targetRef="watchdog__state" name="" /><bpmn:sequenceFlow id="f9" sourceRef="watchdog__state" targetRef="watchdog__state_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="watchdog__state_select" targetRef="watchdog__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="watchdog__state_select" targetRef="watchdog__restore" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="watchdog__state_select" targetRef="watchdog__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f13" sourceRef="watchdog__state_select" targetRef="watchdog__return_unresolved" name="" /><bpmn:sequenceFlow id="f14" sourceRef="watchdog__restore" targetRef="watchdog__restore_prepared" name="" /><bpmn:sequenceFlow id="f15" sourceRef="watchdog__restore_prepared" targetRef="watchdog__restore_resolved" name="" /><bpmn:sequenceFlow id="f16" sourceRef="watchdog__restore_resolved" targetRef="watchdog__restore_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="watchdog__restore_resolved" targetRef="watchdog__restore_call" name="" /><bpmn:sequenceFlow id="f18" sourceRef="watchdog__restore_resolved_result" targetRef="watchdog__restore_merge" name="" /><bpmn:sequenceFlow id="f19" sourceRef="watchdog__restore_call" targetRef="watchdog__restore_merge" name="" /><bpmn:sequenceFlow id="f20" sourceRef="watchdog__restore_merge" targetRef="watchdog__restore_mapped" name="" /><bpmn:sequenceFlow id="f21" sourceRef="watchdog__restore_mapped" targetRef="watchdog__restore_disposition" name="" /><bpmn:sequenceFlow id="f22" sourceRef="watchdog__handoff" targetRef="watchdog__handoff_status" name="" /><bpmn:sequenceFlow id="f23" sourceRef="watchdog__handoff_status" targetRef="watchdog__handoff_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="watchdog__handoff_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f25" sourceRef="watchdog__handoff_accept" targetRef="watchdog__end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="watchdog__end" targetRef="watchdog__end_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="watchdog__pending" targetRef="watchdog__pending_end" name="" /><bpmn:sequenceFlow id="f28" sourceRef="watchdog__restore_disposition" targetRef="watchdog__handoff" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f30" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="watchdog__restore_disposition" targetRef="watchdog__return_unresolved" name="" /><bpmn:sequenceFlow id="f35" sourceRef="watchdog__return_rejected" targetRef="watchdog__return_rejected_end" name="" /><bpmn:sequenceFlow id="f36" sourceRef="watchdog__return_deferred" targetRef="watchdog__return_deferred_end" name="" /><bpmn:sequenceFlow id="f37" sourceRef="watchdog__return_pending" targetRef="watchdog__return_pending_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="watchdog__return_unresolved" targetRef="watchdog__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="watchdog__return_faulted" targetRef="watchdog__return_faulted_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>