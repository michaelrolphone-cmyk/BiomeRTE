<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.escalation" name="Assistance and escalation" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Choose configured assistance paths while preserving data exposure and authority requirements.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="escalation__start" b:set="{}" /><bpmn:serviceTask id="escalation__policy" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;task&quot;: &quot;policy&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="escalation__policy_status" default="f7" /><bpmn:task id="escalation__policy_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="escalation__route" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;gateway&quot;: &quot;route&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="escalation__route_select" default="f13" /><bpmn:serviceTask id="escalation__delegate" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;task&quot;: &quot;delegate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="escalation__delegate_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="escalation__delegate_resolved" default="f17" /><bpmn:task id="escalation__delegate_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="escalation__delegate_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="escalation__delegate_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;task&quot;: &quot;delegate&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="escalation__delegate_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="escalation__judge" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;task&quot;: &quot;judge&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="escalation__judge_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="escalation__judge_resolved" default="f25" /><bpmn:task id="escalation__judge_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="escalation__judge_call" calledElement="assistant.judgment" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="escalation__judge_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;task&quot;: &quot;judge&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="escalation__judge_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="escalation__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="escalation__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="escalation__pending_status" default="f33" /><bpmn:task id="escalation__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:exclusiveGateway id="escalation__delegate__disposition" default="f41" /><bpmn:serviceTask id="escalation__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="escalation__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="escalation__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="escalation__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="escalation__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="escalation__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="escalation__judge__disposition" default="f53" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;escalation&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="escalation__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="escalation__start" targetRef="escalation__policy" name="" /><bpmn:sequenceFlow id="f5" sourceRef="escalation__policy" targetRef="escalation__policy_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="escalation__policy_status" targetRef="escalation__policy_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="escalation__policy_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="escalation__policy_accept" targetRef="escalation__route" name="" /><bpmn:sequenceFlow id="f9" sourceRef="escalation__route" targetRef="escalation__route_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="escalation__route_select" targetRef="escalation__delegate" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="escalation__route_select" targetRef="escalation__judge" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="escalation__route_select" targetRef="escalation__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f13" sourceRef="escalation__route_select" targetRef="escalation__return_unresolved" name="" /><bpmn:sequenceFlow id="f14" sourceRef="escalation__delegate" targetRef="escalation__delegate_prepared" name="" /><bpmn:sequenceFlow id="f15" sourceRef="escalation__delegate_prepared" targetRef="escalation__delegate_resolved" name="" /><bpmn:sequenceFlow id="f16" sourceRef="escalation__delegate_resolved" targetRef="escalation__delegate_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="escalation__delegate_resolved" targetRef="escalation__delegate_call" name="" /><bpmn:sequenceFlow id="f18" sourceRef="escalation__delegate_resolved_result" targetRef="escalation__delegate_merge" name="" /><bpmn:sequenceFlow id="f19" sourceRef="escalation__delegate_call" targetRef="escalation__delegate_merge" name="" /><bpmn:sequenceFlow id="f20" sourceRef="escalation__delegate_merge" targetRef="escalation__delegate_mapped" name="" /><bpmn:sequenceFlow id="f21" sourceRef="escalation__delegate_mapped" targetRef="escalation__delegate__disposition" name="" /><bpmn:sequenceFlow id="f22" sourceRef="escalation__judge" targetRef="escalation__judge_prepared" name="" /><bpmn:sequenceFlow id="f23" sourceRef="escalation__judge_prepared" targetRef="escalation__judge_resolved" name="" /><bpmn:sequenceFlow id="f24" sourceRef="escalation__judge_resolved" targetRef="escalation__judge_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f25" sourceRef="escalation__judge_resolved" targetRef="escalation__judge_call" name="" /><bpmn:sequenceFlow id="f26" sourceRef="escalation__judge_resolved_result" targetRef="escalation__judge_merge" name="" /><bpmn:sequenceFlow id="f27" sourceRef="escalation__judge_call" targetRef="escalation__judge_merge" name="" /><bpmn:sequenceFlow id="f28" sourceRef="escalation__judge_merge" targetRef="escalation__judge_mapped" name="" /><bpmn:sequenceFlow id="f29" sourceRef="escalation__judge_mapped" targetRef="escalation__judge__disposition" name="" /><bpmn:sequenceFlow id="f30" sourceRef="escalation__end" targetRef="escalation__end_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="escalation__pending" targetRef="escalation__pending_status" name="" /><bpmn:sequenceFlow id="f32" sourceRef="escalation__pending_status" targetRef="escalation__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="escalation__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f34" sourceRef="escalation__pending_resume" targetRef="escalation__policy" name="" /><bpmn:sequenceFlow id="f35" sourceRef="escalation__delegate__disposition" targetRef="escalation__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f39" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f40" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f41" sourceRef="escalation__delegate__disposition" targetRef="escalation__return_unresolved" name="" /><bpmn:sequenceFlow id="f42" sourceRef="escalation__return_rejected" targetRef="escalation__return_rejected_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="escalation__return_deferred" targetRef="escalation__return_deferred_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="escalation__return_pending" targetRef="escalation__return_pending_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="escalation__return_unresolved" targetRef="escalation__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f46" sourceRef="escalation__return_faulted" targetRef="escalation__return_faulted_end" name="" /><bpmn:sequenceFlow id="f47" sourceRef="escalation__judge__disposition" targetRef="escalation__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f48" sourceRef="escalation__judge__disposition" targetRef="escalation__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f49" sourceRef="escalation__judge__disposition" targetRef="escalation__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f50" sourceRef="escalation__judge__disposition" targetRef="escalation__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f51" sourceRef="escalation__judge__disposition" targetRef="escalation__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f52" sourceRef="escalation__judge__disposition" targetRef="escalation__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f53" sourceRef="escalation__judge__disposition" targetRef="escalation__return_unresolved" name="" /><bpmn:sequenceFlow id="f54" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f55" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>