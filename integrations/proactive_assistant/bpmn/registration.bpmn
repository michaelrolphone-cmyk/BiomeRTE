<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.registration" name="Responsibility registration and configuration" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Create or change one authorized standing responsibility idempotently.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="registration__start" b:set="{}" /><bpmn:serviceTask id="registration__intent" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;task&quot;: &quot;intent&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="registration__intent_status" default="f7" /><bpmn:task id="registration__intent_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="registration__apply" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;task&quot;: &quot;apply&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="registration__apply_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="registration__apply_resolved" default="f12" /><bpmn:task id="registration__apply_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="registration__apply_call" calledElement="assistant.governed" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="registration__apply_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;task&quot;: &quot;apply&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="registration__apply_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="registration__read" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="registration__read_status" default="f19" /><bpmn:task id="registration__read_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="registration__state" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;gateway&quot;: &quot;state&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="registration__state_select" default="f25" /><bpmn:serviceTask id="registration__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="registration__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="registration__pending_status" default="f29" /><bpmn:task id="registration__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="registration__conflict" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;conflict&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__conflict_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="registration__apply_disposition" default="f38" /><bpmn:serviceTask id="registration__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="registration__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="registration__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="registration__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="registration__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="registration__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;registration&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="registration__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="registration__start" targetRef="registration__intent" name="" /><bpmn:sequenceFlow id="f5" sourceRef="registration__intent" targetRef="registration__intent_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="registration__intent_status" targetRef="registration__intent_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="registration__intent_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="registration__intent_accept" targetRef="registration__apply" name="" /><bpmn:sequenceFlow id="f9" sourceRef="registration__apply" targetRef="registration__apply_prepared" name="" /><bpmn:sequenceFlow id="f10" sourceRef="registration__apply_prepared" targetRef="registration__apply_resolved" name="" /><bpmn:sequenceFlow id="f11" sourceRef="registration__apply_resolved" targetRef="registration__apply_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="registration__apply_resolved" targetRef="registration__apply_call" name="" /><bpmn:sequenceFlow id="f13" sourceRef="registration__apply_resolved_result" targetRef="registration__apply_merge" name="" /><bpmn:sequenceFlow id="f14" sourceRef="registration__apply_call" targetRef="registration__apply_merge" name="" /><bpmn:sequenceFlow id="f15" sourceRef="registration__apply_merge" targetRef="registration__apply_mapped" name="" /><bpmn:sequenceFlow id="f16" sourceRef="registration__apply_mapped" targetRef="registration__apply_disposition" name="" /><bpmn:sequenceFlow id="f17" sourceRef="registration__read" targetRef="registration__read_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="registration__read_status" targetRef="registration__read_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="registration__read_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="registration__read_accept" targetRef="registration__state" name="" /><bpmn:sequenceFlow id="f21" sourceRef="registration__state" targetRef="registration__state_select" name="" /><bpmn:sequenceFlow id="f22" sourceRef="registration__state_select" targetRef="registration__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="registration__state_select" targetRef="registration__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="registration__state_select" targetRef="registration__conflict" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f25" sourceRef="registration__state_select" targetRef="registration__return_unresolved" name="" /><bpmn:sequenceFlow id="f26" sourceRef="registration__end" targetRef="registration__end_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="registration__pending" targetRef="registration__pending_status" name="" /><bpmn:sequenceFlow id="f28" sourceRef="registration__pending_status" targetRef="registration__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="registration__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f30" sourceRef="registration__pending_resume" targetRef="registration__read" name="" /><bpmn:sequenceFlow id="f31" sourceRef="registration__conflict" targetRef="registration__conflict_end" name="" /><bpmn:sequenceFlow id="f32" sourceRef="registration__apply_disposition" targetRef="registration__read" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="registration__apply_disposition" targetRef="registration__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="registration__apply_disposition" targetRef="registration__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="registration__apply_disposition" targetRef="registration__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="registration__apply_disposition" targetRef="registration__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="registration__apply_disposition" targetRef="registration__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="registration__apply_disposition" targetRef="registration__return_unresolved" name="" /><bpmn:sequenceFlow id="f39" sourceRef="registration__return_rejected" targetRef="registration__return_rejected_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="registration__return_deferred" targetRef="registration__return_deferred_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="registration__return_pending" targetRef="registration__return_pending_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="registration__return_unresolved" targetRef="registration__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="registration__return_faulted" targetRef="registration__return_faulted_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>