<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.access" name="Scoped observation and record access" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Make internal read exemptions explicit and enforce all other access through the same execution boundary.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="access__start" b:set="{}" /><bpmn:serviceTask id="access__classify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;task&quot;: &quot;classify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="access__classify_status" default="f7" /><bpmn:task id="access__classify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="access__execute" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;task&quot;: &quot;execute&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="access__execute_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="access__execute_resolved" default="f12" /><bpmn:task id="access__execute_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="access__execute_call" calledElement="assistant.execution" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="access__execute_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;task&quot;: &quot;execute&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="access__execute_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="access__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="access__execute__disposition" default="f24" /><bpmn:serviceTask id="access__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="access__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="access__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="access__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="access__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="access__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;access&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="access__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="access__start" targetRef="access__classify" name="" /><bpmn:sequenceFlow id="f5" sourceRef="access__classify" targetRef="access__classify_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="access__classify_status" targetRef="access__classify_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="access__classify_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="access__classify_accept" targetRef="access__execute" name="" /><bpmn:sequenceFlow id="f9" sourceRef="access__execute" targetRef="access__execute_prepared" name="" /><bpmn:sequenceFlow id="f10" sourceRef="access__execute_prepared" targetRef="access__execute_resolved" name="" /><bpmn:sequenceFlow id="f11" sourceRef="access__execute_resolved" targetRef="access__execute_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="access__execute_resolved" targetRef="access__execute_call" name="" /><bpmn:sequenceFlow id="f13" sourceRef="access__execute_resolved_result" targetRef="access__execute_merge" name="" /><bpmn:sequenceFlow id="f14" sourceRef="access__execute_call" targetRef="access__execute_merge" name="" /><bpmn:sequenceFlow id="f15" sourceRef="access__execute_merge" targetRef="access__execute_mapped" name="" /><bpmn:sequenceFlow id="f16" sourceRef="access__execute_mapped" targetRef="access__execute__disposition" name="" /><bpmn:sequenceFlow id="f17" sourceRef="access__end" targetRef="access__end_end" name="" /><bpmn:sequenceFlow id="f18" sourceRef="access__execute__disposition" targetRef="access__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="access__execute__disposition" targetRef="access__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="access__execute__disposition" targetRef="access__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="access__execute__disposition" targetRef="access__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f22" sourceRef="access__execute__disposition" targetRef="access__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="access__execute__disposition" targetRef="access__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f24" sourceRef="access__execute__disposition" targetRef="access__return_unresolved" name="" /><bpmn:sequenceFlow id="f25" sourceRef="access__return_rejected" targetRef="access__return_rejected_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="access__return_deferred" targetRef="access__return_deferred_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="access__return_pending" targetRef="access__return_pending_end" name="" /><bpmn:sequenceFlow id="f28" sourceRef="access__return_unresolved" targetRef="access__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f29" sourceRef="access__return_faulted" targetRef="access__return_faulted_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>