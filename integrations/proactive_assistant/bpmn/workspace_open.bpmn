<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.workspace_open" name="Provision and pin an episode workspace" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Own one workspace per independent episode run; use the Mac provider and immutable Linux or ESP-IDF template.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="workspace_open__start" b:set="{}" /><bpmn:serviceTask id="workspace_open__provision" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;task&quot;: &quot;provision&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_open__provision_status" default="f7" /><bpmn:task id="workspace_open__provision_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_open__acquire" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;task&quot;: &quot;acquire&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_open__acquire_status" default="f11" /><bpmn:task id="workspace_open__acquire_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_open__clone" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;task&quot;: &quot;clone&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_open__clone_status" default="f15" /><bpmn:task id="workspace_open__clone_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_open__pin" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;task&quot;: &quot;pin&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_open__pin_status" default="f19" /><bpmn:task id="workspace_open__pin_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_open__snapshot" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;task&quot;: &quot;snapshot&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_open__snapshot_status" default="f23" /><bpmn:task id="workspace_open__snapshot_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_open__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="workspace_open__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;workspace_open&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="workspace_open__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="workspace_open__start" targetRef="workspace_open__provision" name="" /><bpmn:sequenceFlow id="f5" sourceRef="workspace_open__provision" targetRef="workspace_open__provision_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="workspace_open__provision_status" targetRef="workspace_open__provision_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="workspace_open__provision_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="workspace_open__provision_accept" targetRef="workspace_open__acquire" name="" /><bpmn:sequenceFlow id="f9" sourceRef="workspace_open__acquire" targetRef="workspace_open__acquire_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="workspace_open__acquire_status" targetRef="workspace_open__acquire_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="workspace_open__acquire_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="workspace_open__acquire_accept" targetRef="workspace_open__clone" name="" /><bpmn:sequenceFlow id="f13" sourceRef="workspace_open__clone" targetRef="workspace_open__clone_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="workspace_open__clone_status" targetRef="workspace_open__clone_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="workspace_open__clone_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="workspace_open__clone_accept" targetRef="workspace_open__pin" name="" /><bpmn:sequenceFlow id="f17" sourceRef="workspace_open__pin" targetRef="workspace_open__pin_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="workspace_open__pin_status" targetRef="workspace_open__pin_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="workspace_open__pin_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="workspace_open__pin_accept" targetRef="workspace_open__snapshot" name="" /><bpmn:sequenceFlow id="f21" sourceRef="workspace_open__snapshot" targetRef="workspace_open__snapshot_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="workspace_open__snapshot_status" targetRef="workspace_open__snapshot_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="workspace_open__snapshot_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="workspace_open__snapshot_accept" targetRef="workspace_open__end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="workspace_open__end" targetRef="workspace_open__end_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>