<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.faults" name="Fault classification and typed yield" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Distinguish uncertain effects, recoverable inference faults and ordinary failed stages.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="faults__start" b:set="{}" /><bpmn:serviceTask id="faults__classify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;task&quot;: &quot;classify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="faults__classify_status" default="f7" /><bpmn:task id="faults__classify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="faults__route" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;gateway&quot;: &quot;route&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="faults__route_select" default="f12" /><bpmn:serviceTask id="faults__reconcile" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;task&quot;: &quot;reconcile&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="faults__reconcile_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="faults__reconcile_resolved" default="f16" /><bpmn:task id="faults__reconcile_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="faults__reconcile_call" calledElement="assistant.reconcile" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="faults__reconcile_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;task&quot;: &quot;reconcile&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="faults__reconcile_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="faults__record" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;task&quot;: &quot;record&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="faults__record_status" default="f23" /><bpmn:task id="faults__record_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="faults__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="faults__reconcile__disposition" default="f32" /><bpmn:serviceTask id="faults__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="faults__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="faults__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="faults__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="faults__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="faults__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;faults&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="faults__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="faults__start" targetRef="faults__classify" name="" /><bpmn:sequenceFlow id="f5" sourceRef="faults__classify" targetRef="faults__classify_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="faults__classify_status" targetRef="faults__classify_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="faults__classify_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="faults__classify_accept" targetRef="faults__route" name="" /><bpmn:sequenceFlow id="f9" sourceRef="faults__route" targetRef="faults__route_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="faults__route_select" targetRef="faults__reconcile" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="faults__route_select" targetRef="faults__record" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="faults__route_select" targetRef="faults__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="faults__reconcile" targetRef="faults__reconcile_prepared" name="" /><bpmn:sequenceFlow id="f14" sourceRef="faults__reconcile_prepared" targetRef="faults__reconcile_resolved" name="" /><bpmn:sequenceFlow id="f15" sourceRef="faults__reconcile_resolved" targetRef="faults__reconcile_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="faults__reconcile_resolved" targetRef="faults__reconcile_call" name="" /><bpmn:sequenceFlow id="f17" sourceRef="faults__reconcile_resolved_result" targetRef="faults__reconcile_merge" name="" /><bpmn:sequenceFlow id="f18" sourceRef="faults__reconcile_call" targetRef="faults__reconcile_merge" name="" /><bpmn:sequenceFlow id="f19" sourceRef="faults__reconcile_merge" targetRef="faults__reconcile_mapped" name="" /><bpmn:sequenceFlow id="f20" sourceRef="faults__reconcile_mapped" targetRef="faults__reconcile__disposition" name="" /><bpmn:sequenceFlow id="f21" sourceRef="faults__record" targetRef="faults__record_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="faults__record_status" targetRef="faults__record_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="faults__record_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="faults__record_accept" targetRef="faults__end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="faults__end" targetRef="faults__end_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="faults__reconcile__disposition" targetRef="faults__record" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="faults__reconcile__disposition" targetRef="faults__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="faults__reconcile__disposition" targetRef="faults__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="faults__reconcile__disposition" targetRef="faults__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f30" sourceRef="faults__reconcile__disposition" targetRef="faults__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="faults__reconcile__disposition" targetRef="faults__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="faults__reconcile__disposition" targetRef="faults__return_unresolved" name="" /><bpmn:sequenceFlow id="f33" sourceRef="faults__return_rejected" targetRef="faults__return_rejected_end" name="" /><bpmn:sequenceFlow id="f34" sourceRef="faults__return_deferred" targetRef="faults__return_deferred_end" name="" /><bpmn:sequenceFlow id="f35" sourceRef="faults__return_pending" targetRef="faults__return_pending_end" name="" /><bpmn:sequenceFlow id="f36" sourceRef="faults__return_unresolved" targetRef="faults__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f37" sourceRef="faults__return_faulted" targetRef="faults__return_faulted_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>