<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.wake" name="Durable responsibility wake delivery" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Coalesce events, due inspections and episode continuations into a correlated admission trigger.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="wake__start" b:set="{}" /><bpmn:serviceTask id="wake__read" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="wake__read_status" default="f7" /><bpmn:task id="wake__read_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="wake__state" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;gateway&quot;: &quot;state&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="wake__state_select" default="f13" /><bpmn:serviceTask id="wake__record" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;task&quot;: &quot;record&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="wake__record_status" default="f16" /><bpmn:task id="wake__record_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="wake__admit" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;task&quot;: &quot;admit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="wake__admit_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="wake__admit_resolved" default="f21" /><bpmn:task id="wake__admit_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="wake__admit_call" calledElement="assistant.cycle_admission" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="wake__admit_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;task&quot;: &quot;admit&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="wake__admit_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="wake__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="wake__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="wake__pending_status" default="f29" /><bpmn:task id="wake__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="wake__held" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;held&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__held_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="wake__admit_disposition" default="f38" /><bpmn:serviceTask id="wake__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="wake__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="wake__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="wake__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="wake__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="wake__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;wake&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="wake__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="wake__start" targetRef="wake__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="wake__read" targetRef="wake__read_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="wake__read_status" targetRef="wake__read_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="wake__read_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="wake__read_accept" targetRef="wake__state" name="" /><bpmn:sequenceFlow id="f9" sourceRef="wake__state" targetRef="wake__state_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="wake__state_select" targetRef="wake__record" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="wake__state_select" targetRef="wake__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="wake__state_select" targetRef="wake__held" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f13" sourceRef="wake__state_select" targetRef="wake__return_unresolved" name="" /><bpmn:sequenceFlow id="f14" sourceRef="wake__record" targetRef="wake__record_status" name="" /><bpmn:sequenceFlow id="f15" sourceRef="wake__record_status" targetRef="wake__record_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="wake__record_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f17" sourceRef="wake__record_accept" targetRef="wake__admit" name="" /><bpmn:sequenceFlow id="f18" sourceRef="wake__admit" targetRef="wake__admit_prepared" name="" /><bpmn:sequenceFlow id="f19" sourceRef="wake__admit_prepared" targetRef="wake__admit_resolved" name="" /><bpmn:sequenceFlow id="f20" sourceRef="wake__admit_resolved" targetRef="wake__admit_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="wake__admit_resolved" targetRef="wake__admit_call" name="" /><bpmn:sequenceFlow id="f22" sourceRef="wake__admit_resolved_result" targetRef="wake__admit_merge" name="" /><bpmn:sequenceFlow id="f23" sourceRef="wake__admit_call" targetRef="wake__admit_merge" name="" /><bpmn:sequenceFlow id="f24" sourceRef="wake__admit_merge" targetRef="wake__admit_mapped" name="" /><bpmn:sequenceFlow id="f25" sourceRef="wake__admit_mapped" targetRef="wake__admit_disposition" name="" /><bpmn:sequenceFlow id="f26" sourceRef="wake__end" targetRef="wake__end_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="wake__pending" targetRef="wake__pending_status" name="" /><bpmn:sequenceFlow id="f28" sourceRef="wake__pending_status" targetRef="wake__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="wake__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f30" sourceRef="wake__pending_resume" targetRef="wake__read" name="" /><bpmn:sequenceFlow id="f31" sourceRef="wake__held" targetRef="wake__held_end" name="" /><bpmn:sequenceFlow id="f32" sourceRef="wake__admit_disposition" targetRef="wake__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="wake__admit_disposition" targetRef="wake__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="wake__admit_disposition" targetRef="wake__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="wake__admit_disposition" targetRef="wake__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="wake__admit_disposition" targetRef="wake__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="wake__admit_disposition" targetRef="wake__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="wake__admit_disposition" targetRef="wake__return_unresolved" name="" /><bpmn:sequenceFlow id="f39" sourceRef="wake__return_rejected" targetRef="wake__return_rejected_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="wake__return_deferred" targetRef="wake__return_deferred_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="wake__return_pending" targetRef="wake__return_pending_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="wake__return_unresolved" targetRef="wake__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="wake__return_faulted" targetRef="wake__return_faulted_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>