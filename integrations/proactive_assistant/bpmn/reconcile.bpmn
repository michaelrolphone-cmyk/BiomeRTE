<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.reconcile" name="Nonblocking operation reconciliation" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Observe once and return pending or unresolved instead of synchronously waiting for long operations.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="reconcile__start" b:set="{}" /><bpmn:serviceTask id="reconcile__read" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="reconcile__read_status" default="f7" /><bpmn:task id="reconcile__read_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="reconcile__route" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;gateway&quot;: &quot;route&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="reconcile__route_select" default="f14" /><bpmn:serviceTask id="reconcile__inspect" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;task&quot;: &quot;inspect&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="reconcile__inspect_status" default="f17" /><bpmn:task id="reconcile__inspect_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="reconcile__known" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;gateway&quot;: &quot;known&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="reconcile__known_select" default="f23" /><bpmn:serviceTask id="reconcile__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="reconcile__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="reconcile__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="reconcile__pending_status" default="f27" /><bpmn:task id="reconcile__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="reconcile__unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;terminal&quot;: &quot;unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="reconcile__unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="reconcile__fault" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;terminal&quot;: &quot;fault&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="reconcile__fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="reconcile__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="reconcile__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;reconcile&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="reconcile__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="reconcile__start" targetRef="reconcile__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="reconcile__read" targetRef="reconcile__read_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="reconcile__read_status" targetRef="reconcile__read_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="reconcile__read_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="reconcile__read_accept" targetRef="reconcile__route" name="" /><bpmn:sequenceFlow id="f9" sourceRef="reconcile__route" targetRef="reconcile__route_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="reconcile__route_select" targetRef="reconcile__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="reconcile__route_select" targetRef="reconcile__fault" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="reconcile__route_select" targetRef="reconcile__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f13" sourceRef="reconcile__route_select" targetRef="reconcile__inspect" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 3]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f14" sourceRef="reconcile__route_select" targetRef="reconcile__return_unresolved" name="" /><bpmn:sequenceFlow id="f15" sourceRef="reconcile__inspect" targetRef="reconcile__inspect_status" name="" /><bpmn:sequenceFlow id="f16" sourceRef="reconcile__inspect_status" targetRef="reconcile__inspect_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="reconcile__inspect_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f18" sourceRef="reconcile__inspect_accept" targetRef="reconcile__known" name="" /><bpmn:sequenceFlow id="f19" sourceRef="reconcile__known" targetRef="reconcile__known_select" name="" /><bpmn:sequenceFlow id="f20" sourceRef="reconcile__known_select" targetRef="reconcile__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="reconcile__known_select" targetRef="reconcile__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f22" sourceRef="reconcile__known_select" targetRef="reconcile__unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="reconcile__known_select" targetRef="reconcile__return_unresolved" name="" /><bpmn:sequenceFlow id="f24" sourceRef="reconcile__end" targetRef="reconcile__end_end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="reconcile__pending" targetRef="reconcile__pending_status" name="" /><bpmn:sequenceFlow id="f26" sourceRef="reconcile__pending_status" targetRef="reconcile__pending_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="reconcile__pending_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f28" sourceRef="reconcile__pending_resume" targetRef="reconcile__read" name="" /><bpmn:sequenceFlow id="f29" sourceRef="reconcile__unresolved" targetRef="reconcile__unresolved_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="reconcile__fault" targetRef="reconcile__fault_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="reconcile__return_unresolved" targetRef="reconcile__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f32" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f33" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>