n__end_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__intent" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f31" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f32" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f33" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="revision_adoption__qualify_disposition" targetRef="revision_adoption__return_unresolved" name="" /><bpmn:sequenceFlow id="f37" sourceRef="revision_adoption__return_rejected" targetRef="revision_adoption__return_rejected_end" name="" /><bpmn:sequenceFlow id="f38" sourceRef="revision_adoption__return_deferred" targetRef="revision_adoption__return_deferred_end" name="" /><bpmn:sequenceFlow id="f39" sourceRef="revision_adoption__return_pending" targetRef="revision_adoption__return_pending_end" name="" /><bpmn:sequenceFlow id="f40" sourceRef="revision_adoption__return_unresolved" targetRef="revision_adoption__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="revision_adoption__return_faulted" targetRef="revision_adoption__return_faulted_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__confirm" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f43" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f44" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f45" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f46" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f47" sourceRef="revision_adoption__apply_disposition" targetRef="revision_adoption__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq",