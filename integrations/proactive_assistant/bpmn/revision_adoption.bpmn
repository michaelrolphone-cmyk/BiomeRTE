<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.revision_adoption" name="Adopt qualified workflow revisions" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Pin new cycle bindings at a safe boundary without rewriting active episodes.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="revision_adoption__start" b:set="{}" /><bpmn:serviceTask id="revision_adoption__qualify" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;qualify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="revision_adoption__qualify_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="revision_adoption__qualify_resolved" default="f8" /><bpmn:task id="revision_adoption__qualify_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="revision_adoption__qualify_call" calledElement="assistant.qualification" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="revision_adoption__qualify_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;qualify&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="revision_adoption__qualify_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="revision_adoption__intent" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;intent&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="revision_adoption__intent_status" default="f15" /><bpmn:task id="revision_adoption__intent_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="revision_adoption__apply" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;apply&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="revision_adoption__apply_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="revision_adoption__apply_resolved" default="f20" /><bpmn:task id="revision_adoption__apply_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="revision_adoption__apply_call" calledElement="assistant.governed" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="revision_adoption__apply_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;apply&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="revision_adoption__apply_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="revision_adoption__confirm" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;task&quot;: &quot;confirm&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="revision_adoption__confirm_status" default="f27" /><bpmn:task id="revision_adoption__confirm_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="revision_adoption__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="revision_adoption__qualify_disposition" default="f36" /><bpmn:serviceTask id="revision_adoption__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="revision_adoption__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="revision_adoption__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="revision_adoption__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="revision_adoption__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="revision_adoption__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="revision_adoption__apply_disposition" default="f48" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;revision_adoption&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="revision_adoption__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="revision_adoption__start" targetRef="revision_adoption__qualify" name="" /><bpmn:sequenceFlow id="f5" sourceRef="revision_adoption__qualify" targetRef="revision_adoption__qualify_prepared" name="" /><bpmn:sequenceFlow id="f6" sourceRef="revision_adoption__qualify_prepared" targetRef="revision_adoption__qualify_resolved" name="" /><bpmn:sequenceFlow id="f7" sourceRef="revision_adoption__qualify_resolved" targetRef="revision_adoption__qualify_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f8" sourceRef="revision_adoption__qualify_resolved" targetRef="revision_adoption__qualify_call" name="" /><bpmn:sequenceFlow id="f9" sourceRef="revision_adoption__qualify_resolved_result" targetRef="revision_adoption__qualify_merge" name="" /><bpmn:sequenceFlow id="f10" sourceRef="revision_adoption__qualify_call" targetRef="revision_adoption__qualify_merge" name="" /><bpmn:sequenceFlow id="f11" sourceRef="revision_adoption__qualify_merge" targetRef="revision_adoption__qualify_mapped" name="" /><bpmn:sequenceFlow id="f12" sourceRef="revision_adoption__qualify_mapped" targetRef="revision_adoption__qualify_disposition" name="" /><bpmn:sequenceFlow id="f13" sourceRef="revision_adoption__intent" targetRef="revision_adoption__intent_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="revision_adoption__intent_status" targetRef="revision_adoption__intent_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="revision_adoption__intent_status" targetR