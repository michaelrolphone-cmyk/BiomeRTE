<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.progress" name="Evidence-based progress assessment" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Recommend continue, reframe, wait, conclude or assistance without invented runtime caps.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="progress__start" b:set="{}" /><bpmn:serviceTask id="progress__measure" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;task&quot;: &quot;measure&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="progress__measure_status" default="f7" /><bpmn:task id="progress__measure_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="progress__repeat" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;task&quot;: &quot;repeat&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="progress__repeat_status" default="f11" /><bpmn:task id="progress__repeat_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="progress__route" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;gateway&quot;: &quot;route&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="progress__route_select" default="f19" /><bpmn:serviceTask id="progress__continue" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;continue&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="progress__continue_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="progress__reframe" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;reframe&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="progress__reframe_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="progress__assist" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;assist&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="progress__assist_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="progress__negative" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;negative&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="progress__negative_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="progress__wait" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;wait&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="progress__wait_status" default="f26" /><bpmn:task id="progress__wait_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="progress__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="progress__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;progress&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="progress__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="progress__start" targetRef="progress__measure" name="" /><bpmn:sequenceFlow id="f5" sourceRef="progress__measure" targetRef="progress__measure_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="progress__measure_status" targetRef="progress__measure_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="progress__measure_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="progress__measure_accept" targetRef="progress__repeat" name="" /><bpmn:sequenceFlow id="f9" sourceRef="progress__repeat" targetRef="progress__repeat_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="progress__repeat_status" targetRef="progress__repeat_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="progress__repeat_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="progress__repeat_accept" targetRef="progress__route" name="" /><bpmn:sequenceFlow id="f13" sourceRef="progress__route" targetRef="progress__route_select" name="" /><bpmn:sequenceFlow id="f14" sourceRef="progress__route_select" targetRef="progress__continue" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="progress__route_select" targetRef="progress__reframe" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="progress__route_select" targetRef="progress__assist" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="progress__route_select" targetRef="progress__negative" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 3]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f18" sourceRef="progress__route_select" targetRef="progress__wait" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 4]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="progress__route_select" targetRef="progress__return_unresolved" name="" /><bpmn:sequenceFlow id="f20" sourceRef="progress__continue" targetRef="progress__continue_end" name="" /><bpmn:sequenceFlow id="f21" sourceRef="progress__reframe" targetRef="progress__reframe_end" name="" /><bpmn:sequenceFlow id="f22" sourceRef="progress__assist" targetRef="progress__assist_end" name="" /><bpmn:sequenceFlow id="f23" sourceRef="progress__negative" targetRef="progress__negative_end" name="" /><bpmn:sequenceFlow id="f24" sourceRef="progress__wait" targetRef="progress__wait_status" name="" /><bpmn:sequenceFlow id="f25" sourceRef="progress__wait_status" targetRef="progress__wait_resume" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f26" sourceRef="progress__wait_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f27" sourceRef="progress__wait_resume" targetRef="progress__measure" name="" /><bpmn:sequenceFlow id="f28" sourceRef="progress__return_unresolved" targetRef="progress__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f29" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f30" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>