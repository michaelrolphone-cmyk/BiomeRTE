me="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="cycle_admission__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="cycle_admission__start" targetRef="cycle_admission__inspect" name="" /><bpmn:sequenceFlow id="f5" sourceRef="cycle_admission__inspect" targetRef="cycle_admission__inspect_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="cycle_admission__inspect_status" targetRef="cycle_admission__inspect_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="cycle_admission__inspect_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="cycle_admission__inspect_accept" targetRef="cycle_admission__existing" name="" /><bpmn:sequenceFlow id="f9" sourceRef="cycle_admission__existing" targetRef="cycle_admission__existing_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="cycle_admission__existing_select" targetRef="cycle_admission__return_existing" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="cycle_admission__existing_select" targetRef="cycle_admission__state" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="cycle_admission__existing_select" targetRef="cycle_admission__return_unresolved" name="" /><bpmn:sequenceFlow id="f13" sourceRef="cycle_admission__return_existing" targetRef="cycle_admission__return_existing_end" name="" /><bpmn:sequenceFlow id="f14" sourceRef="cycle_admission__state" targetRef="cycle_admission__state_select" name="" /><bpmn:sequenceFlow id="f15" sourceRef="cycle_admission__state_select" targetRef="cycle_admission__reserve" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="cycle_admission__state_select" targetRef="cycle_admission__paused" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f17" sourceRef="cycle_admission__state_select" targetRef="cycle_admission__stopped" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f18" sourceRef="cycle_admission__state_select" targetRef="cycle_admission__return_unresolved" name="" /><bpmn:sequenceFlow id="f19" sourceRef="cycle_admission__reserve" targetRef="cycle_admission__reserve_status" name="" /><bpmn:sequenceFlow id="f20" sourceRef="cycle_admission__reserve_status" targetRef="cycle_admission__reserve_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="cycle_admission__reserve_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f22" sourceRef="cycle_admission__reserve_accept" targetRef="cycle_admission__result" name="" /><bpmn:sequenceFlow id="f23" sourceRef="cycle_admission__result" targetRef="cycle_admission__result_select" name="" /><bpmn:sequenceFlow id="f24" sourceRef="cycle_admission__result_select" targetRef="cycle_admission__deliver" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f25" sourceRef="cycle_admission__result_select" targetRef="cycle_admission__coalesced" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f26" sourceRef="cycle_admission__result_select" targetRef="cycle_admission__stale" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</