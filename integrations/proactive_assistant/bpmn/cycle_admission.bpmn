<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.cycle_admission" name="Trigger coalescing and cycle admission" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Turn durable events into at most one admitted cycle per responsibility.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="cycle_admission__start" b:set="{}" /><bpmn:serviceTask id="cycle_admission__inspect" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;task&quot;: &quot;inspect&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__inspect_status" default="f7" /><bpmn:task id="cycle_admission__inspect_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_admission__existing" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;gateway&quot;: &quot;existing&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__existing_select" default="f12" /><bpmn:serviceTask id="cycle_admission__return_existing" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;terminal&quot;: &quot;return_existing&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_admission__return_existing_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_admission__state" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;gateway&quot;: &quot;state&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__state_select" default="f18" /><bpmn:serviceTask id="cycle_admission__reserve" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;task&quot;: &quot;reserve&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__reserve_status" default="f21" /><bpmn:task id="cycle_admission__reserve_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_admission__result" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;gateway&quot;: &quot;result&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__result_select" default="f28" /><bpmn:serviceTask id="cycle_admission__deliver" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;task&quot;: &quot;deliver&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__deliver_status" default="f31" /><bpmn:task id="cycle_admission__deliver_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_admission__known" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;gateway&quot;: &quot;known&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__known_select" default="f36" /><bpmn:serviceTask id="cycle_admission__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_admission__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_admission__coalesced" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;terminal&quot;: &quot;coalesced&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="cycle_admission__coalesced_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="cycle_admission__pending" b:operation="assistant.wait" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="cycle_admission__pending_status" default="f41" /><bpmn:task id="cycle_admission__pending_resume" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="cycle_admission__paused" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;cycle_admission&quot;, &quot;terminal&quot;: &quot;paused&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent