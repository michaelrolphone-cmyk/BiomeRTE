<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.system_review" name="Individual system checklist" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Assess one named system against the proposed action.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="system_review__start" b:set="{}" /><bpmn:serviceTask id="system_review__direct" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;task&quot;: &quot;direct&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="system_review__direct_status" default="f7" /><bpmn:task id="system_review__direct_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="system_review__indirect" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;task&quot;: &quot;indirect&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="system_review__indirect_status" default="f11" /><bpmn:task id="system_review__indirect_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="system_review__data" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;task&quot;: &quot;data&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="system_review__data_status" default="f15" /><bpmn:task id="system_review__data_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="system_review__protect" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;task&quot;: &quot;protect&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="system_review__protect_status" default="f19" /><bpmn:task id="system_review__protect_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="system_review__verify" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;task&quot;: &quot;verify&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="system_review__verify_status" default="f23" /><bpmn:task id="system_review__verify_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="system_review__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="system_review__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;system_review&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="system_review__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="system_review__start" targetRef="system_review__direct" name="" /><bpmn:sequenceFlow id="f5" sourceRef="system_review__direct" targetRef="system_review__direct_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="system_review__direct_status" targetRef="system_review__direct_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="system_review__direct_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="system_review__direct_accept" targetRef="system_review__indirect" name="" /><bpmn:sequenceFlow id="f9" sourceRef="system_review__indirect" targetRef="system_review__indirect_status" name="" /><bpmn:sequenceFlow id="f10" sourceRef="system_review__indirect_status" targetRef="system_review__indirect_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="system_review__indirect_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f12" sourceRef="system_review__indirect_accept" targetRef="system_review__data" name="" /><bpmn:sequenceFlow id="f13" sourceRef="system_review__data" targetRef="system_review__data_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="system_review__data_status" targetRef="system_review__data_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="system_review__data_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="system_review__data_accept" targetRef="system_review__protect" name="" /><bpmn:sequenceFlow id="f17" sourceRef="system_review__protect" targetRef="system_review__protect_status" name="" /><bpmn:sequenceFlow id="f18" sourceRef="system_review__protect_status" targetRef="system_review__protect_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="system_review__protect_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f20" sourceRef="system_review__protect_accept" targetRef="system_review__verify" name="" /><bpmn:sequenceFlow id="f21" sourceRef="system_review__verify" targetRef="system_review__verify_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="system_review__verify_status" targetRef="system_review__verify_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="system_review__verify_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="system_review__verify_accept" targetRef="system_review__end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="system_review__end" targetRef="system_review__end_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>