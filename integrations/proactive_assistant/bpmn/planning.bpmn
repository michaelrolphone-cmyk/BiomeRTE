<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.planning" name="Prioritization and capacity allocation" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Reserve only eligible independent work and return actual reasons for waiting.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="planning__start" b:set="{}" /><bpmn:serviceTask id="planning__read" b:operation="assistant.before" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;task&quot;: &quot;read&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="prepared" b:onError="fault_capture" /><bpmn:task id="planning__read_prepared" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;prepared.frame&quot;}}" /><bpmn:exclusiveGateway id="planning__read_resolved" default="f8" /><bpmn:task id="planning__read_resolved_result" b:set="{&quot;child_result&quot;: {&quot;$&quot;: &quot;prepared.result&quot;}}" /><bpmn:callActivity id="planning__read_call" calledElement="assistant.access" b:args="{&quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="child_result" b:onError="fault_capture" /><bpmn:serviceTask id="planning__read_merge" b:operation="assistant.child" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;task&quot;: &quot;read&quot;, &quot;child&quot;: {&quot;$&quot;: &quot;child_result&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:task id="planning__read_mapped" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="planning__rank" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;task&quot;: &quot;rank&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="planning__rank_status" default="f15" /><bpmn:task id="planning__rank_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="planning__fit" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;gateway&quot;: &quot;fit&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="planning__fit_select" default="f20" /><bpmn:serviceTask id="planning__reserve" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;task&quot;: &quot;reserve&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="planning__reserve_status" default="f23" /><bpmn:task id="planning__reserve_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="planning__reserved" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;gateway&quot;: &quot;reserved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="planning__reserved_select" default="f29" /><bpmn:serviceTask id="planning__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__wait" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;wait&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__wait_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__conflict" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;conflict&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__conflict_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:exclusiveGateway id="planning__read__disposition" default="f39" /><bpmn:serviceTask id="planning__return_rejected" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;return_rejected&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__return_rejected_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__return_deferred" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;return_deferred&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__return_deferred_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__return_pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;return_pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__return_pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="planning__return_faulted" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;terminal&quot;: &quot;return_faulted&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="planning__return_faulted_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;planning&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="planning__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="planning__start" targetRef="planning__read" name="" /><bpmn:sequenceFlow id="f5" sourceRef="planning__read" targetRef="planning__read_prepared" name="" /><bpmn:sequenceFlow id="f6" sourceRef="planning__read_prepared" targetRef="planning__read_resolved" name="" /><bpmn:sequenceFlow id="f7" sourceRef="planning__read_resolved" targetRef="planning__read_resolved_result" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "prepared.resolved"}, true]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f8" sourceRef="planning__read_resolved" targetRef="planning__read_call" name="" /><bpmn:sequenceFlow id="f9" sourceRef="planning__read_resolved_result" targetRef="planning__read_merge" name="" /><bpmn:sequenceFlow id="f10" sourceRef="planning__read_call" targetRef="planning__read_merge" name="" /><bpmn:sequenceFlow id="f11" sourceRef="planning__read_merge" targetRef="planning__read_mapped" name="" /><bpmn:sequenceFlow id="f12" sourceRef="planning__read_mapped" targetRef="planning__read__disposition" name="" /><bpmn:sequenceFlow id="f13" sourceRef="planning__rank" targetRef="planning__rank_status" name="" /><bpmn:sequenceFlow id="f14" sourceRef="planning__rank_status" targetRef="planning__rank_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f15" sourceRef="planning__rank_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f16" sourceRef="planning__rank_accept" targetRef="planning__fit" name="" /><bpmn:sequenceFlow id="f17" sourceRef="planning__fit" targetRef="planning__fit_select" name="" /><bpmn:sequenceFlow id="f18" sourceRef="planning__fit_select" targetRef="planning__reserve" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f19" sourceRef="planning__fit_select" targetRef="planning__wait" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="planning__fit_select" targetRef="planning__return_unresolved" name="" /><bpmn:sequenceFlow id="f21" sourceRef="planning__reserve" targetRef="planning__reserve_status" name="" /><bpmn:sequenceFlow id="f22" sourceRef="planning__reserve_status" targetRef="planning__reserve_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f23" sourceRef="planning__reserve_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f24" sourceRef="planning__reserve_accept" targetRef="planning__reserved" name="" /><bpmn:sequenceFlow id="f25" sourceRef="planning__reserved" targetRef="planning__reserved_select" name="" /><bpmn:sequenceFlow id="f26" sourceRef="planning__reserved_select" targetRef="planning__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f27" sourceRef="planning__reserved_select" targetRef="planning__wait" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f28" sourceRef="planning__reserved_select" targetRef="planning__conflict" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f29" sourceRef="planning__reserved_select" targetRef="planning__return_unresolved" name="" /><bpmn:sequenceFlow id="f30" sourceRef="planning__end" targetRef="planning__end_end" name="" /><bpmn:sequenceFlow id="f31" sourceRef="planning__wait" targetRef="planning__wait_end" name="" /><bpmn:sequenceFlow id="f32" sourceRef="planning__conflict" targetRef="planning__conflict_end" name="" /><bpmn:sequenceFlow id="f33" sourceRef="planning__read__disposition" targetRef="planning__rank" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f34" sourceRef="planning__read__disposition" targetRef="planning__return_rejected" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "rejected"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f35" sourceRef="planning__read__disposition" targetRef="planning__return_deferred" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "deferred"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="planning__read__disposition" targetRef="planning__return_pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "pending"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="planning__read__disposition" targetRef="planning__return_unresolved" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "unresolved"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f38" sourceRef="planning__read__disposition" targetRef="planning__return_faulted" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "frame.last_disposition"}, "faulted"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f39" sourceRef="planning__read__disposition" targetRef="planning__return_unresolved" name="" /><bpmn:sequenceFlow id="f40" sourceRef="planning__return_rejected" targetRef="planning__return_rejected_end" name="" /><bpmn:sequenceFlow id="f41" sourceRef="planning__return_deferred" targetRef="planning__return_deferred_end" name="" /><bpmn:sequenceFlow id="f42" sourceRef="planning__return_pending" targetRef="planning__return_pending_end" name="" /><bpmn:sequenceFlow id="f43" sourceRef="planning__return_unresolved" targetRef="planning__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f44" sourceRef="planning__return_faulted" targetRef="planning__return_faulted_end" name="" /><bpmn:sequenceFlow id="f45" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f46" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>