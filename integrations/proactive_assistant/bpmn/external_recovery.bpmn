<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.external_recovery" name="Independent recovery enforcement" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Validate a narrowly preauthorized Biome host-recovery intent without requiring the failed controller to execute its own guard.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="external_recovery__start" b:set="{}" /><bpmn:serviceTask id="external_recovery__validate" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;task&quot;: &quot;validate&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="external_recovery__validate_status" default="f7" /><bpmn:task id="external_recovery__validate_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="external_recovery__allowed" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;gateway&quot;: &quot;allowed&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="external_recovery__allowed_select" default="f13" /><bpmn:serviceTask id="external_recovery__invoke" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;task&quot;: &quot;invoke&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="external_recovery__invoke_status" default="f16" /><bpmn:task id="external_recovery__invoke_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="external_recovery__receipt" b:operation="assistant.route" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;gateway&quot;: &quot;receipt&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="route" b:onError="fault_capture" /><bpmn:exclusiveGateway id="external_recovery__receipt_select" default="f21" /><bpmn:serviceTask id="external_recovery__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="external_recovery__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="external_recovery__pending" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;terminal&quot;: &quot;pending&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="external_recovery__pending_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="external_recovery__reject" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;terminal&quot;: &quot;reject&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="external_recovery__reject_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="external_recovery__return_unresolved" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;terminal&quot;: &quot;return_unresolved&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="external_recovery__return_unresolved_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;external_recovery&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="external_recovery__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="external_recovery__start" targetRef="external_recovery__validate" name="" /><bpmn:sequenceFlow id="f5" sourceRef="external_recovery__validate" targetRef="external_recovery__validate_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="external_recovery__validate_status" targetRef="external_recovery__validate_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="external_recovery__validate_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="external_recovery__validate_accept" targetRef="external_recovery__allowed" name="" /><bpmn:sequenceFlow id="f9" sourceRef="external_recovery__allowed" targetRef="external_recovery__allowed_select" name="" /><bpmn:sequenceFlow id="f10" sourceRef="external_recovery__allowed_select" targetRef="external_recovery__invoke" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f11" sourceRef="external_recovery__allowed_select" targetRef="external_recovery__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f12" sourceRef="external_recovery__allowed_select" targetRef="external_recovery__reject" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 2]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f13" sourceRef="external_recovery__allowed_select" targetRef="external_recovery__return_unresolved" name="" /><bpmn:sequenceFlow id="f14" sourceRef="external_recovery__invoke" targetRef="external_recovery__invoke_status" name="" /><bpmn:sequenceFlow id="f15" sourceRef="external_recovery__invoke_status" targetRef="external_recovery__invoke_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f16" sourceRef="external_recovery__invoke_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f17" sourceRef="external_recovery__invoke_accept" targetRef="external_recovery__receipt" name="" /><bpmn:sequenceFlow id="f18" sourceRef="external_recovery__receipt" targetRef="external_recovery__receipt_select" name="" /><bpmn:sequenceFlow id="f19" sourceRef="external_recovery__receipt_select" targetRef="external_recovery__end" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 0]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f20" sourceRef="external_recovery__receipt_select" targetRef="external_recovery__pending" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "route.index"}, 1]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f21" sourceRef="external_recovery__receipt_select" targetRef="external_recovery__return_unresolved" name="" /><bpmn:sequenceFlow id="f22" sourceRef="external_recovery__end" targetRef="external_recovery__end_end" name="" /><bpmn:sequenceFlow id="f23" sourceRef="external_recovery__pending" targetRef="external_recovery__pending_end" name="" /><bpmn:sequenceFlow id="f24" sourceRef="external_recovery__reject" targetRef="external_recovery__reject_end" name="" /><bpmn:sequenceFlow id="f25" sourceRef="external_recovery__return_unresolved" targetRef="external_recovery__return_unresolved_end" name="" /><bpmn:sequenceFlow id="f26" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f27" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>