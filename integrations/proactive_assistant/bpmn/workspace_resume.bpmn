<bpmn:definitions xmlns:b="urn:biomerte:v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="urn:biome:assistant:delivery:1"><bpmn:process id="assistant.workspace_resume" name="Recover the same workspace" isExecutable="true" b:inputs="{&quot;frame&quot;: &quot;obj&quot;}" b:outputs="{&quot;disposition&quot;: &quot;str&quot;, &quot;result_code&quot;: &quot;str&quot;, &quot;data&quot;: &quot;obj&quot;, &quot;evidence_refs&quot;: &quot;list&quot;, &quot;continuation&quot;: &quot;obj&quot;, &quot;harm_status&quot;: &quot;str&quot;, &quot;origin&quot;: &quot;obj&quot;, &quot;frame&quot;: &quot;obj&quot;}"><bpmn:documentation>Acquire the same stable workspace from its checkpoint, pinning its original provider, template and platform.</bpmn:documentation><bpmn:startEvent id="entry" /><bpmn:task id="input_frame" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" /><bpmn:serviceTask id="initialize" b:operation="assistant.enter" b:args="{&quot;logical_process&quot;: &quot;workspace_resume&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;input.frame&quot;}}" b:save="frame" b:onError="fault_capture" /><bpmn:task id="workspace_resume__start" b:set="{}" /><bpmn:serviceTask id="workspace_resume__acquire" b:operation="assistant.stage" b:args="{&quot;logical_process&quot;: &quot;workspace_resume&quot;, &quot;task&quot;: &quot;acquire&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="step" b:onError="fault_capture" /><bpmn:exclusiveGateway id="workspace_resume__acquire_status" default="f7" /><bpmn:task id="workspace_resume__acquire_accept" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}}" /><bpmn:serviceTask id="workspace_resume__end" b:operation="assistant.finish" b:args="{&quot;logical_process&quot;: &quot;workspace_resume&quot;, &quot;terminal&quot;: &quot;end&quot;, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" b:onError="fault_capture" /><bpmn:endEvent id="workspace_resume__end_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:task id="propagate" b:set="{&quot;frame&quot;: {&quot;$&quot;: &quot;step.frame&quot;}, &quot;result&quot;: {&quot;$&quot;: &quot;step&quot;}}" /><bpmn:endEvent id="propagate_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:serviceTask id="fault_capture" b:operation="assistant.fault" b:args="{&quot;logical_process&quot;: &quot;workspace_resume&quot;, &quot;error&quot;: {&quot;$&quot;: &quot;error&quot;}, &quot;frame&quot;: {&quot;$&quot;: &quot;frame&quot;}}" b:save="result" /><bpmn:endEvent id="fault_end" b:result="{&quot;$&quot;: &quot;result&quot;}" /><bpmn:sequenceFlow id="f1" sourceRef="entry" targetRef="input_frame" name="" /><bpmn:sequenceFlow id="f2" sourceRef="input_frame" targetRef="initialize" name="" /><bpmn:sequenceFlow id="f3" sourceRef="initialize" targetRef="workspace_resume__start" name="" /><bpmn:sequenceFlow id="f4" sourceRef="workspace_resume__start" targetRef="workspace_resume__acquire" name="" /><bpmn:sequenceFlow id="f5" sourceRef="workspace_resume__acquire" targetRef="workspace_resume__acquire_status" name="" /><bpmn:sequenceFlow id="f6" sourceRef="workspace_resume__acquire_status" targetRef="workspace_resume__acquire_accept" name=""><bpmn:conditionExpression>{"op": "eq", "args": [{"$": "step.disposition"}, "completed"]}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f7" sourceRef="workspace_resume__acquire_status" targetRef="propagate" name="" /><bpmn:sequenceFlow id="f8" sourceRef="workspace_resume__acquire_accept" targetRef="workspace_resume__end" name="" /><bpmn:sequenceFlow id="f9" sourceRef="workspace_resume__end" targetRef="workspace_resume__end_end" name="" /><bpmn:sequenceFlow id="f10" sourceRef="propagate" targetRef="propagate_end" name="" /><bpmn:sequenceFlow id="f11" sourceRef="fault_capture" targetRef="fault_end" name="" /></bpmn:process></bpmn:definitions>