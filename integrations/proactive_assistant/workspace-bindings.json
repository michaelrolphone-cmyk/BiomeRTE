  "source": "workspace.git:1 operates /workspace/source; git.cli:1 operates separate host namespaces",
  "ownership": "independent episode run ID, never finite lifecycle cycle ID",
  "provisioning": "Concrete run ID for internal assistant stage; $current only for native direct workspace service calls",
  "provider_result": "Inspect ok; expand and SHA256 verify artifact chunks; inspect command exit_code; preserve unknown effect IDs",
  "cleanup": "Publish outputs before terminal state; monitor disposes only after owning run and children terminal. Unresolved/deferred/faulted workspace outcomes park the same token. Explicit cancellation permits disposal.",
  "handoff": "workspace.handoff:1 then use returned holder/generation and checkpoint; direct callers retain context and source/test/publication refs",
  "templates": [
    "linux-basic@1",
    "esp-idf@2"
  ],
  "limitations": [
    "Mac execution only; additional providers are not deployed.",
    "Template images and checkpoints use local Docker image store and verified host archives, not a remote OCI registry.",
    "Cross-host/host-loss recovery and emulated firmware boot/hardware flashing are not qualified.",
    "Credentials currently reuse the existing non-admin Biome GitLab service identity, not per-run project-scoped tokens.",
    "Agents explicitly publish outputs before run termination. No automatic declared-artifact publisher is implemented.",
    "Active delegated agents are not automatically suspended merely because the orchestrator has a delegate wait."
  ]
